<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_OffboardingAsIs" targetNamespace="https://elams.example/bpmn" exporter="Camunda Modeler" exporterVersion="5.53.0">
  <bpmn:message id="Message_DateChange" name="Thông báo thay đổi ngày nghỉ việc" />
  <bpmn:message id="Message_Urgent" name="Thông báo nghỉ việc đột xuất" />
  <bpmn:message id="Message_Reply" name="Phản hồi đã xử lý việc còn thiếu" />
  <bpmn:collaboration id="Collaboration_OffboardingAsIs">
    <bpmn:participant id="Pool_TechNova" name="TechNova – Employee Offboarding (As-Is)" processRef="Process_OffboardingAsIs" />
    <bpmn:textAnnotation id="Note_Tracking">
      <bpmn:text>Hiện trạng: mỗi bộ phận tự theo dõi nhánh của mình; HR phải đối chiếu email, Excel và biên bản để biết đã đủ điều kiện hay chưa (PP-12, PP-15).</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Note_Device">
      <bpmn:text>Thiết bị chưa hoàn trả chỉ được nhắc qua trao đổi thủ công; chưa có cơ chế ghi nhận ngoại lệ thống nhất (PP-13).</bpmn:text>
    </bpmn:textAnnotation>
  </bpmn:collaboration>
  <bpmn:process id="Process_OffboardingAsIs" name="Employee Offboarding – As-Is" isExecutable="false">
    <bpmn:documentation>As-Is Offboarding (AS-03), bản rút gọn ngày 21/11/2026. Chỉ mô tả hiện trạng thủ công: ba nhánh bàn giao công việc, thu hồi quyền và thu hồi thiết bị chạy song song; HR đối chiếu thủ công trước khi xác nhận hoàn tất. Các kiểm soát mới (phê duyệt ngoại lệ, bằng chứng, xác minh thu hồi) thuộc To-Be theo GAP-OFF-04, GAP-OFF-05. Quy trình giả lập, chưa được xác minh với doanh nghiệp thực tế.</bpmn:documentation>
    <bpmn:laneSet id="Lane_HR_Set">
      <bpmn:lane id="Lane_HR" name="HR">
        <bpmn:flowNodeRef>OFF_Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T01</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T02</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T03</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AND_Split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AND_Join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T17</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G04</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T18</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_Reply</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T19</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>OFF_End</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Sub_DateChange</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Sub_Urgent</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Manager" name="Manager">
        <bpmn:flowNodeRef>T04</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T06</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G01</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T07</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Employee" name="Employee">
        <bpmn:flowNodeRef>T12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T05</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_IT" name="IT">
        <bpmn:flowNodeRef>T13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G03</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T14</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T16</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T08</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T09</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G02</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T11</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="OFF_Start" name="Đã xác nhận thông tin nghỉ việc">
      <bpmn:outgoing>Flow_OFF_Start_T01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="T01" name="Tiếp nhận thông tin nghỉ việc">
      <bpmn:incoming>Flow_OFF_Start_T01</bpmn:incoming>
      <bpmn:outgoing>Flow_T01_T02</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T02" name="Ghi nhận thông tin vào Excel">
      <bpmn:incoming>Flow_T01_T02</bpmn:incoming>
      <bpmn:outgoing>Flow_T02_T03</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T03" name="Gửi email thông báo cho Manager và IT">
      <bpmn:incoming>Flow_T02_T03</bpmn:incoming>
      <bpmn:outgoing>Flow_T03_AND_Split</bpmn:outgoing>
    </bpmn:task>
    <bpmn:parallelGateway id="AND_Split" name="Ba nhánh xử lý độc lập">
      <bpmn:incoming>Flow_T03_AND_Split</bpmn:incoming>
      <bpmn:outgoing>Flow_AND_Split_T04</bpmn:outgoing>
      <bpmn:outgoing>Flow_AND_Split_T12</bpmn:outgoing>
      <bpmn:outgoing>Flow_AND_Split_T08</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="T04" name="Lập kế hoạch bàn giao công việc">
      <bpmn:incoming>Flow_AND_Split_T04</bpmn:incoming>
      <bpmn:outgoing>Flow_T04_T05</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T06" name="Kiểm tra bàn giao công việc">
      <bpmn:incoming>Flow_T05_T06</bpmn:incoming>
      <bpmn:outgoing>Flow_T06_G01</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G01" name="Bàn giao đầy đủ?">
      <bpmn:incoming>Flow_T06_G01</bpmn:incoming>
      <bpmn:outgoing>Flow_G01_T07</bpmn:outgoing>
      <bpmn:outgoing>Flow_G01_T05</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T07" name="Báo kết quả bàn giao cho HR qua email">
      <bpmn:incoming>Flow_G01_T07</bpmn:incoming>
      <bpmn:outgoing>Flow_T07_AND_Join</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T13" name="Kiểm tra thiết bị và ghi nhận thu hồi">
      <bpmn:incoming>Flow_T12_T13</bpmn:incoming>
      <bpmn:outgoing>Flow_T13_G03</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G03" name="Đã thu hồi đủ thiết bị?">
      <bpmn:incoming>Flow_T13_G03</bpmn:incoming>
      <bpmn:outgoing>Flow_G03_T16</bpmn:outgoing>
      <bpmn:outgoing>Flow_G03_T14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T14" name="Nhắc nhân viên hoàn trả; báo HR và Manager">
      <bpmn:incoming>Flow_G03_T14</bpmn:incoming>
      <bpmn:outgoing>Flow_T14_T12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T16" name="Báo kết quả thu hồi thiết bị cho HR">
      <bpmn:incoming>Flow_G03_T16</bpmn:incoming>
      <bpmn:outgoing>Flow_T16_AND_Join</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T08" name="Xác định tài khoản và quyền cần thu hồi">
      <bpmn:incoming>Flow_AND_Split_T08</bpmn:incoming>
      <bpmn:outgoing>Flow_T08_T09</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T09" name="Thu hồi hoặc vô hiệu hóa quyền truy cập">
      <bpmn:incoming>Flow_T08_T09</bpmn:incoming>
      <bpmn:incoming>Flow_T10_T09</bpmn:incoming>
      <bpmn:outgoing>Flow_T09_G02</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G02" name="Thu hồi thành công?">
      <bpmn:incoming>Flow_T09_G02</bpmn:incoming>
      <bpmn:outgoing>Flow_G02_T11</bpmn:outgoing>
      <bpmn:outgoing>Flow_G02_T10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T10" name="Ghi nhận lỗi và xử lý sự cố thu hồi">
      <bpmn:incoming>Flow_G02_T10</bpmn:incoming>
      <bpmn:outgoing>Flow_T10_T09</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T11" name="Báo kết quả thu hồi quyền cho HR">
      <bpmn:incoming>Flow_G02_T11</bpmn:incoming>
      <bpmn:outgoing>Flow_T11_AND_Join</bpmn:outgoing>
    </bpmn:task>
    <bpmn:parallelGateway id="AND_Join" name="Chờ đủ ba nhánh">
      <bpmn:incoming>Flow_T07_AND_Join</bpmn:incoming>
      <bpmn:incoming>Flow_T16_AND_Join</bpmn:incoming>
      <bpmn:incoming>Flow_T11_AND_Join</bpmn:incoming>
      <bpmn:outgoing>Flow_AND_Join_T17</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="T17" name="Đối chiếu email, Excel và biên bản bàn giao">
      <bpmn:incoming>Flow_AND_Join_T17</bpmn:incoming>
      <bpmn:incoming>Flow_E_Reply_T17</bpmn:incoming>
      <bpmn:outgoing>Flow_T17_G04</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G04" name="Đủ điều kiện hoàn tất?">
      <bpmn:incoming>Flow_T17_G04</bpmn:incoming>
      <bpmn:outgoing>Flow_G04_T19</bpmn:outgoing>
      <bpmn:outgoing>Flow_G04_T18</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T18" name="Nhắc bộ phận xử lý việc còn thiếu">
      <bpmn:incoming>Flow_G04_T18</bpmn:incoming>
      <bpmn:outgoing>Flow_T18_E_Reply</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="E_Reply" name="Nhận phản hồi đã xử lý">
      <bpmn:incoming>Flow_T18_E_Reply</bpmn:incoming>
      <bpmn:outgoing>Flow_E_Reply_T17</bpmn:outgoing>
      <bpmn:messageEventDefinition id="E_Reply_Def" messageRef="Message_Reply" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="T19" name="Xác nhận hoàn tất offboarding">
      <bpmn:incoming>Flow_G04_T19</bpmn:incoming>
      <bpmn:outgoing>Flow_T19_OFF_End</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="OFF_End" name="Offboarding hoàn tất">
      <bpmn:incoming>Flow_T19_OFF_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:subProcess id="Sub_DateChange" name="Thay đổi ngày nghỉ việc" triggeredByEvent="true">
      <bpmn:laneSet id="Date_Lane_HR_Set">
        <bpmn:lane id="Date_Lane_HR" name="HR">
          <bpmn:flowNodeRef>Date_Start</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Date_Update</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Date_Split</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Date_Join</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Date_End</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="Date_Lane_Manager" name="Manager">
          <bpmn:flowNodeRef>Date_Manager</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="Date_Lane_IT" name="IT">
          <bpmn:flowNodeRef>Date_IT</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="Date_Start" name="Nhận thông báo thay đổi ngày nghỉ việc" isInterrupting="false">
        <bpmn:outgoing>Flow_Date_Start_Date_Update</bpmn:outgoing>
        <bpmn:messageEventDefinition id="Date_Start_Def" messageRef="Message_DateChange" />
      </bpmn:startEvent>
      <bpmn:task id="Date_Update" name="Cập nhật Excel và gửi email ngày mới cho Manager, IT">
        <bpmn:incoming>Flow_Date_Start_Date_Update</bpmn:incoming>
        <bpmn:outgoing>Flow_Date_Update_Date_Split</bpmn:outgoing>
      </bpmn:task>
      <bpmn:parallelGateway id="Date_Split" name="">
        <bpmn:incoming>Flow_Date_Update_Date_Split</bpmn:incoming>
        <bpmn:outgoing>Flow_Date_Split_Date_Manager</bpmn:outgoing>
        <bpmn:outgoing>Flow_Date_Split_Date_IT</bpmn:outgoing>
      </bpmn:parallelGateway>
      <bpmn:task id="Date_Manager" name="Điều chỉnh kế hoạch bàn giao">
        <bpmn:incoming>Flow_Date_Split_Date_Manager</bpmn:incoming>
        <bpmn:outgoing>Flow_Date_Manager_Date_Join</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="Date_IT" name="Điều chỉnh kế hoạch thu hồi quyền và thiết bị">
        <bpmn:incoming>Flow_Date_Split_Date_IT</bpmn:incoming>
        <bpmn:outgoing>Flow_Date_IT_Date_Join</bpmn:outgoing>
      </bpmn:task>
      <bpmn:parallelGateway id="Date_Join" name="">
        <bpmn:incoming>Flow_Date_Manager_Date_Join</bpmn:incoming>
        <bpmn:incoming>Flow_Date_IT_Date_Join</bpmn:incoming>
        <bpmn:outgoing>Flow_Date_Join_Date_End</bpmn:outgoing>
      </bpmn:parallelGateway>
      <bpmn:endEvent id="Date_End" name="Đã cập nhật kế hoạch">
        <bpmn:incoming>Flow_Date_Join_Date_End</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_Date_Start_Date_Update" sourceRef="Date_Start" targetRef="Date_Update" />
      <bpmn:sequenceFlow id="Flow_Date_Update_Date_Split" sourceRef="Date_Update" targetRef="Date_Split" />
      <bpmn:sequenceFlow id="Flow_Date_Split_Date_Manager" sourceRef="Date_Split" targetRef="Date_Manager" />
      <bpmn:sequenceFlow id="Flow_Date_Split_Date_IT" sourceRef="Date_Split" targetRef="Date_IT" />
      <bpmn:sequenceFlow id="Flow_Date_Manager_Date_Join" sourceRef="Date_Manager" targetRef="Date_Join" />
      <bpmn:sequenceFlow id="Flow_Date_IT_Date_Join" sourceRef="Date_IT" targetRef="Date_Join" />
      <bpmn:sequenceFlow id="Flow_Date_Join_Date_End" sourceRef="Date_Join" targetRef="Date_End" />
    </bpmn:subProcess>
    <bpmn:subProcess id="Sub_Urgent" name="Nghỉ việc đột xuất" triggeredByEvent="true">
      <bpmn:laneSet id="Urgent_Lane_HR_Set">
        <bpmn:lane id="Urgent_Lane_HR" name="HR">
          <bpmn:flowNodeRef>Urgent_Start</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Urgent_Notify</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="Urgent_Lane_IT" name="IT">
          <bpmn:flowNodeRef>Urgent_Revoke</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Urgent_End</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="Urgent_Start" name="Nhận thông báo nghỉ việc đột xuất" isInterrupting="false">
        <bpmn:outgoing>Flow_Urgent_Start_Urgent_Notify</bpmn:outgoing>
        <bpmn:messageEventDefinition id="Urgent_Start_Def" messageRef="Message_Urgent" />
      </bpmn:startEvent>
      <bpmn:task id="Urgent_Notify" name="Thông báo khẩn cho IT và Manager">
        <bpmn:incoming>Flow_Urgent_Start_Urgent_Notify</bpmn:incoming>
        <bpmn:outgoing>Flow_Urgent_Notify_Urgent_Revoke</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="Urgent_Revoke" name="Ưu tiên thu hồi quyền truy cập ngay">
        <bpmn:incoming>Flow_Urgent_Notify_Urgent_Revoke</bpmn:incoming>
        <bpmn:outgoing>Flow_Urgent_Revoke_Urgent_End</bpmn:outgoing>
      </bpmn:task>
      <bpmn:endEvent id="Urgent_End" name="Đã ưu tiên thu hồi quyền">
        <bpmn:incoming>Flow_Urgent_Revoke_Urgent_End</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_Urgent_Start_Urgent_Notify" sourceRef="Urgent_Start" targetRef="Urgent_Notify" />
      <bpmn:sequenceFlow id="Flow_Urgent_Notify_Urgent_Revoke" sourceRef="Urgent_Notify" targetRef="Urgent_Revoke" />
      <bpmn:sequenceFlow id="Flow_Urgent_Revoke_Urgent_End" sourceRef="Urgent_Revoke" targetRef="Urgent_End" />
    </bpmn:subProcess>
    <bpmn:sequenceFlow id="Flow_OFF_Start_T01" sourceRef="OFF_Start" targetRef="T01" />
    <bpmn:sequenceFlow id="Flow_T01_T02" sourceRef="T01" targetRef="T02" />
    <bpmn:sequenceFlow id="Flow_T02_T03" sourceRef="T02" targetRef="T03" />
    <bpmn:sequenceFlow id="Flow_T03_AND_Split" sourceRef="T03" targetRef="AND_Split" />
    <bpmn:sequenceFlow id="Flow_AND_Split_T04" sourceRef="AND_Split" targetRef="T04" />
    <bpmn:sequenceFlow id="Flow_AND_Split_T12" sourceRef="AND_Split" targetRef="T12" />
    <bpmn:sequenceFlow id="Flow_AND_Split_T08" sourceRef="AND_Split" targetRef="T08" />
    <bpmn:sequenceFlow id="Flow_T04_T05" sourceRef="T04" targetRef="T05" />
    <bpmn:sequenceFlow id="Flow_T05_T06" sourceRef="T05" targetRef="T06" />
    <bpmn:sequenceFlow id="Flow_T06_G01" sourceRef="T06" targetRef="G01" />
    <bpmn:sequenceFlow id="Flow_T13_G03" sourceRef="T13" targetRef="G03" />
    <bpmn:sequenceFlow id="Flow_T08_T09" sourceRef="T08" targetRef="T09" />
    <bpmn:sequenceFlow id="Flow_T09_G02" sourceRef="T09" targetRef="G02" />
    <bpmn:sequenceFlow id="Flow_T07_AND_Join" sourceRef="T07" targetRef="AND_Join" />
    <bpmn:sequenceFlow id="Flow_T16_AND_Join" sourceRef="T16" targetRef="AND_Join" />
    <bpmn:sequenceFlow id="Flow_T11_AND_Join" sourceRef="T11" targetRef="AND_Join" />
    <bpmn:sequenceFlow id="Flow_AND_Join_T17" sourceRef="AND_Join" targetRef="T17" />
    <bpmn:sequenceFlow id="Flow_T17_G04" sourceRef="T17" targetRef="G04" />
    <bpmn:sequenceFlow id="Flow_T19_OFF_End" sourceRef="T19" targetRef="OFF_End" />
    <bpmn:sequenceFlow id="Flow_G01_T07" name="Có" sourceRef="G01" targetRef="T07" />
    <bpmn:sequenceFlow id="Flow_G01_T05" name="Không" sourceRef="G01" targetRef="T05" />
    <bpmn:sequenceFlow id="Flow_T12_T13" sourceRef="T12" targetRef="T13" />
    <bpmn:sequenceFlow id="Flow_G03_T16" name="Có" sourceRef="G03" targetRef="T16" />
    <bpmn:sequenceFlow id="Flow_G03_T14" name="Không" sourceRef="G03" targetRef="T14" />
    <bpmn:sequenceFlow id="Flow_T14_T12" sourceRef="T14" targetRef="T12" />
    <bpmn:sequenceFlow id="Flow_G02_T11" name="Có" sourceRef="G02" targetRef="T11" />
    <bpmn:sequenceFlow id="Flow_G02_T10" name="Không" sourceRef="G02" targetRef="T10" />
    <bpmn:sequenceFlow id="Flow_T10_T09" sourceRef="T10" targetRef="T09" />
    <bpmn:sequenceFlow id="Flow_G04_T19" name="Có" sourceRef="G04" targetRef="T19" />
    <bpmn:sequenceFlow id="Flow_G04_T18" name="Không" sourceRef="G04" targetRef="T18" />
    <bpmn:sequenceFlow id="Flow_T18_E_Reply" sourceRef="T18" targetRef="E_Reply" />
    <bpmn:sequenceFlow id="Flow_E_Reply_T17" sourceRef="E_Reply" targetRef="T17" />
    <bpmn:task id="T12" name="Hoàn trả thiết bị">
      <bpmn:incoming>Flow_AND_Split_T12</bpmn:incoming>
      <bpmn:incoming>Flow_T14_T12</bpmn:incoming>
      <bpmn:outgoing>Flow_T12_T13</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T05" name="Bàn giao công việc">
      <bpmn:incoming>Flow_T04_T05</bpmn:incoming>
      <bpmn:incoming>Flow_G01_T05</bpmn:incoming>
      <bpmn:outgoing>Flow_T05_T06</bpmn:outgoing>
    </bpmn:task>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Process_OffboardingAsIs_Diagram">
    <bpmndi:BPMNPlane id="Process_OffboardingAsIs_Plane" bpmnElement="Collaboration_OffboardingAsIs">
      <bpmndi:BPMNShape id="Pool_TechNova_di" bpmnElement="Pool_TechNova" isHorizontal="true">
        <dc:Bounds x="150" y="80" width="2380" height="1040" />
