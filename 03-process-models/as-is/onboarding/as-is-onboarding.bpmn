<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_OnboardingAsIs" targetNamespace="https://elams.example/bpmn" exporter="Camunda Modeler" exporterVersion="5.53.0">
  <bpmn:message id="Message_DateChange" name="Thay đổi ngày bắt đầu làm việc" />
  <bpmn:message id="Message_DeviceAvailable" name="Thiết bị phù hợp đã sẵn sàng" />
  <bpmn:message id="Message_WorkCorrected" name="Công việc còn thiếu đã được xử lý" />
  <bpmn:collaboration id="Collaboration_OnboardingAsIs">
    <bpmn:participant id="Pool_TechNova" name="TechNova – Employee Onboarding (As-Is)" processRef="Process_OnboardingAsIs" />
    <bpmn:textAnnotation id="Note_PainPoints">
      <bpmn:text>Hiện trạng: thông tin trao đổi qua email và Excel; HR không có trạng thái tập trung, phải đối chiếu thủ công khi hoàn tất (PP-01, PP-02, PP-05).</bpmn:text>
    </bpmn:textAnnotation>
  </bpmn:collaboration>
  <bpmn:process id="Process_OnboardingAsIs" name="Employee Onboarding – As-Is" isExecutable="false">
    <bpmn:documentation>As-Is Onboarding (AS-01), bản rút gọn ngày 21/11/2026. Mô tả hiện trạng thủ công qua email, Excel và tin nhắn. Phần xin phê duyệt quyền được thu gọn thành Call Activity tham chiếu AS-02 để tránh lặp lại. Quy trình giả lập, chưa được xác minh với doanh nghiệp thực tế.</bpmn:documentation>
    <bpmn:laneSet id="Lane_HR_Set">
      <bpmn:lane id="Lane_HR" name="HR">
        <bpmn:flowNodeRef>ON_Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T01</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T02</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T03</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T08</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T14</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G03</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T15</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_WorkCorrected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T16</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ON_End</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Sub_DateChange</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Manager" name="Department Manager">
        <bpmn:flowNodeRef>T04</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T05</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T06</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_IT" name="IT Staff">
        <bpmn:flowNodeRef>T07</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G01</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T09</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G02</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_DeviceReady</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T13</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="ON_Start" name="Đã xác nhận nhân viên nhận việc">
      <bpmn:outgoing>Flow_ON_Start_T01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="T01" name="Tiếp nhận thông tin nhân viên mới">
      <bpmn:incoming>Flow_ON_Start_T01</bpmn:incoming>
      <bpmn:outgoing>Flow_T01_T02</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T02" name="Ghi nhận thông tin vào Excel">
      <bpmn:incoming>Flow_T01_T02</bpmn:incoming>
      <bpmn:outgoing>Flow_T02_T03</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T03" name="Gửi email thông báo cho Manager và IT">
      <bpmn:incoming>Flow_T02_T03</bpmn:incoming>
      <bpmn:outgoing>Flow_T03_T04</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T04" name="Xác định quyền truy cập cần cấp">
      <bpmn:incoming>Flow_T03_T04</bpmn:incoming>
      <bpmn:outgoing>Flow_T04_T05</bpmn:outgoing>
    </bpmn:task>
    <bpmn:callActivity id="T05" name="Xin phê duyệt quyền theo quy trình AS-02">
      <bpmn:documentation>Thu gọn quy trình As-Is Access Request &amp; Approval (AS-02): Manager xác nhận, phân loại quyền nhạy cảm, Security xét duyệt, xử lý từ chối và bổ sung. Xem as-is/access-request/as-is-access-request-approval.bpmn.</bpmn:documentation>
      <bpmn:incoming>Flow_T04_T05</bpmn:incoming>
      <bpmn:outgoing>Flow_T05_T06</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:task id="T06" name="Gửi yêu cầu cấp quyền cho IT qua email">
      <bpmn:incoming>Flow_T05_T06</bpmn:incoming>
      <bpmn:outgoing>Flow_T06_T07</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T07" name="Kiểm tra thông tin yêu cầu">
      <bpmn:incoming>Flow_T06_T07</bpmn:incoming>
      <bpmn:incoming>Flow_T08_T07</bpmn:incoming>
      <bpmn:outgoing>Flow_T07_G01</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G01" name="Thông tin đầy đủ?">
      <bpmn:incoming>Flow_T07_G01</bpmn:incoming>
      <bpmn:outgoing>Flow_G01_T09</bpmn:outgoing>
      <bpmn:outgoing>Flow_G01_T08</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T08" name="Bổ sung thông tin và gửi lại cho IT">
      <bpmn:incoming>Flow_G01_T08</bpmn:incoming>
      <bpmn:outgoing>Flow_T08_T07</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T09" name="Tạo tài khoản và cấp quyền đã được phê duyệt">
      <bpmn:incoming>Flow_G01_T09</bpmn:incoming>
      <bpmn:outgoing>Flow_T09_T10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T10" name="Kiểm tra thiết bị phù hợp để cấp">
      <bpmn:incoming>Flow_T09_T10</bpmn:incoming>
      <bpmn:incoming>Flow_E_DeviceReady_T10</bpmn:incoming>
      <bpmn:outgoing>Flow_T10_G02</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G02" name="Có thiết bị phù hợp?">
      <bpmn:incoming>Flow_T10_G02</bpmn:incoming>
      <bpmn:outgoing>Flow_G02_T12</bpmn:outgoing>
      <bpmn:outgoing>Flow_G02_T11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T11" name="Thông báo HR và Manager; chờ bổ sung thiết bị">
      <bpmn:incoming>Flow_G02_T11</bpmn:incoming>
      <bpmn:outgoing>Flow_T11_E_DeviceReady</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="E_DeviceReady" name="Thiết bị phù hợp đã sẵn sàng">
      <bpmn:incoming>Flow_T11_E_DeviceReady</bpmn:incoming>
      <bpmn:outgoing>Flow_E_DeviceReady_T10</bpmn:outgoing>
      <bpmn:messageEventDefinition id="E_DeviceReady_Def" messageRef="Message_DeviceAvailable" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="T12" name="Chuẩn bị và bàn giao thiết bị">
      <bpmn:incoming>Flow_G02_T12</bpmn:incoming>
      <bpmn:outgoing>Flow_T12_T13</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T13" name="Gửi email báo kết quả cho HR">
      <bpmn:incoming>Flow_T12_T13</bpmn:incoming>
      <bpmn:outgoing>Flow_T13_T14</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T14" name="Đối chiếu email và Excel để kiểm tra công việc">
      <bpmn:incoming>Flow_T13_T14</bpmn:incoming>
      <bpmn:incoming>Flow_E_WorkCorrected_T14</bpmn:incoming>
      <bpmn:outgoing>Flow_T14_G03</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G03" name="Các việc bắt buộc đã hoàn tất?">
      <bpmn:incoming>Flow_T14_G03</bpmn:incoming>
      <bpmn:outgoing>Flow_G03_T16</bpmn:outgoing>
      <bpmn:outgoing>Flow_G03_T15</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T15" name="Nhắc bên phụ trách xử lý việc còn thiếu">
      <bpmn:incoming>Flow_G03_T15</bpmn:incoming>
      <bpmn:outgoing>Flow_T15_E_WorkCorrected</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="E_WorkCorrected" name="Nhận xác nhận đã xử lý">
      <bpmn:incoming>Flow_T15_E_WorkCorrected</bpmn:incoming>
      <bpmn:outgoing>Flow_E_WorkCorrected_T14</bpmn:outgoing>
      <bpmn:messageEventDefinition id="E_WorkCorrected_Def" messageRef="Message_WorkCorrected" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="T16" name="Xác nhận hoàn tất onboarding">
      <bpmn:incoming>Flow_G03_T16</bpmn:incoming>
      <bpmn:outgoing>Flow_T16_ON_End</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="ON_End" name="Onboarding hoàn tất">
      <bpmn:incoming>Flow_T16_ON_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:subProcess id="Sub_DateChange" name="Ngoại lệ: thay đổi ngày bắt đầu làm việc" triggeredByEvent="true">
      <bpmn:laneSet id="Date_Lane_HR_Set">
        <bpmn:lane id="Date_Lane_HR" name="HR">
          <bpmn:flowNodeRef>Date_Start</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Date_Update</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Date_Notify</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Date_Split</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Date_Join</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Date_End</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="Date_Lane_Manager" name="Department Manager">
          <bpmn:flowNodeRef>Date_Manager</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="Date_Lane_IT" name="IT Staff">
          <bpmn:flowNodeRef>Date_IT</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="Date_Start" name="Nhận thông báo đổi ngày bắt đầu" isInterrupting="false">
        <bpmn:outgoing>Flow_Date_Start_Date_Update</bpmn:outgoing>
        <bpmn:messageEventDefinition id="Date_Start_Def" messageRef="Message_DateChange" />
      </bpmn:startEvent>
      <bpmn:task id="Date_Update" name="Cập nhật ngày bắt đầu trong Excel">
        <bpmn:incoming>Flow_Date_Start_Date_Update</bpmn:incoming>
        <bpmn:outgoing>Flow_Date_Update_Date_Notify</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="Date_Notify" name="Gửi email ngày mới cho IT và Manager">
        <bpmn:incoming>Flow_Date_Update_Date_Notify</bpmn:incoming>
        <bpmn:outgoing>Flow_Date_Notify_Date_Split</bpmn:outgoing>
      </bpmn:task>
      <bpmn:parallelGateway id="Date_Split" name="">
        <bpmn:incoming>Flow_Date_Notify_Date_Split</bpmn:incoming>
        <bpmn:outgoing>Flow_Date_Split_Date_Manager</bpmn:outgoing>
        <bpmn:outgoing>Flow_Date_Split_Date_IT</bpmn:outgoing>
      </bpmn:parallelGateway>
      <bpmn:task id="Date_Manager" name="Điều chỉnh kế hoạch tiếp nhận">
        <bpmn:incoming>Flow_Date_Split_Date_Manager</bpmn:incoming>
        <bpmn:outgoing>Flow_Date_Manager_Date_Join</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="Date_IT" name="Điều chỉnh kế hoạch tài khoản và thiết bị">
        <bpmn:incoming>Flow_Date_Split_Date_IT</bpmn:incoming>
        <bpmn:outgoing>Flow_Date_IT_Date_Join</bpmn:outgoing>
      </bpmn:task>
      <bpmn:parallelGateway id="Date_Join" name="">
        <bpmn:incoming>Flow_Date_Manager_Date_Join</bpmn:incoming>
        <bpmn:incoming>Flow_Date_IT_Date_Join</bpmn:incoming>
        <bpmn:outgoing>Flow_Date_Join_Date_End</bpmn:outgoing>
      </bpmn:parallelGateway>
      <bpmn:endEvent id="Date_End" name="Đã cập nhật kế hoạch">
        <bpmn:incoming>Flow_Date_Join_Date_End</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_Date_Start_Date_Update" sourceRef="Date_Start" targetRef="Date_Update" />
      <bpmn:sequenceFlow id="Flow_Date_Update_Date_Notify" sourceRef="Date_Update" targetRef="Date_Notify" />
      <bpmn:sequenceFlow id="Flow_Date_Notify_Date_Split" sourceRef="Date_Notify" targetRef="Date_Split" />
      <bpmn:sequenceFlow id="Flow_Date_Split_Date_Manager" sourceRef="Date_Split" targetRef="Date_Manager" />
      <bpmn:sequenceFlow id="Flow_Date_Split_Date_IT" sourceRef="Date_Split" targetRef="Date_IT" />
      <bpmn:sequenceFlow id="Flow_Date_Manager_Date_Join" sourceRef="Date_Manager" targetRef="Date_Join" />
      <bpmn:sequenceFlow id="Flow_Date_IT_Date_Join" sourceRef="Date_IT" targetRef="Date_Join" />
      <bpmn:sequenceFlow id="Flow_Date_Join_Date_End" sourceRef="Date_Join" targetRef="Date_End" />
    </bpmn:subProcess>
    <bpmn:sequenceFlow id="Flow_ON_Start_T01" sourceRef="ON_Start" targetRef="T01" />
    <bpmn:sequenceFlow id="Flow_T01_T02" sourceRef="T01" targetRef="T02" />
    <bpmn:sequenceFlow id="Flow_T02_T03" sourceRef="T02" targetRef="T03" />
    <bpmn:sequenceFlow id="Flow_T03_T04" sourceRef="T03" targetRef="T04" />
    <bpmn:sequenceFlow id="Flow_T04_T05" sourceRef="T04" targetRef="T05" />
    <bpmn:sequenceFlow id="Flow_T05_T06" sourceRef="T05" targetRef="T06" />
    <bpmn:sequenceFlow id="Flow_T06_T07" sourceRef="T06" targetRef="T07" />
    <bpmn:sequenceFlow id="Flow_T07_G01" sourceRef="T07" targetRef="G01" />
    <bpmn:sequenceFlow id="Flow_T09_T10" sourceRef="T09" targetRef="T10" />
    <bpmn:sequenceFlow id="Flow_T10_G02" sourceRef="T10" targetRef="G02" />
    <bpmn:sequenceFlow id="Flow_T12_T13" sourceRef="T12" targetRef="T13" />
    <bpmn:sequenceFlow id="Flow_T13_T14" sourceRef="T13" targetRef="T14" />
    <bpmn:sequenceFlow id="Flow_T14_G03" sourceRef="T14" targetRef="G03" />
    <bpmn:sequenceFlow id="Flow_T16_ON_End" sourceRef="T16" targetRef="ON_End" />
    <bpmn:sequenceFlow id="Flow_G01_T09" name="Có" sourceRef="G01" targetRef="T09" />
    <bpmn:sequenceFlow id="Flow_G01_T08" name="Không" sourceRef="G01" targetRef="T08" />
    <bpmn:sequenceFlow id="Flow_T08_T07" sourceRef="T08" targetRef="T07" />
    <bpmn:sequenceFlow id="Flow_G02_T12" name="Có" sourceRef="G02" targetRef="T12" />
    <bpmn:sequenceFlow id="Flow_G02_T11" name="Không" sourceRef="G02" targetRef="T11" />
    <bpmn:sequenceFlow id="Flow_T11_E_DeviceReady" sourceRef="T11" targetRef="E_DeviceReady" />
    <bpmn:sequenceFlow id="Flow_E_DeviceReady_T10" sourceRef="E_DeviceReady" targetRef="T10" />
    <bpmn:sequenceFlow id="Flow_G03_T16" name="Có" sourceRef="G03" targetRef="T16" />
    <bpmn:sequenceFlow id="Flow_G03_T15" name="Không" sourceRef="G03" targetRef="T15" />
    <bpmn:sequenceFlow id="Flow_T15_E_WorkCorrected" sourceRef="T15" targetRef="E_WorkCorrected" />
    <bpmn:sequenceFlow id="Flow_E_WorkCorrected_T14" sourceRef="E_WorkCorrected" targetRef="T14" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Process_OnboardingAsIs_Diagram">
    <bpmndi:BPMNPlane id="Process_OnboardingAsIs_Plane" bpmnElement="Collaboration_OnboardingAsIs">
