<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_AccessRequestAsIs" targetNamespace="https://elams.example/bpmn" exporter="Camunda Modeler" exporterVersion="5.53.0">
  <bpmn:collaboration id="Collaboration_AccessRequestAsIs">
    <bpmn:participant id="Pool_TechNova" name="TechNova – Access Request &#38; Approval (As-Is)" processRef="Process_AccessRequestAsIs" />
    <bpmn:textAnnotation id="Note_Assumption">
      <bpmn:text>Giả định cần xác nhận: chỉ kết thúc E04 khi có xác nhận hủy hoặc không thể hoàn thiện; không tự động hủy vì quá hạn.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Note_PainPoints">
      <bpmn:text>Hiện trạng: yêu cầu và phê duyệt trao đổi qua email; Manager tự phân loại quyền nhạy cảm; IT phải tự xác minh phê duyệt (PP-06 đến PP-10).</bpmn:text>
    </bpmn:textAnnotation>
  </bpmn:collaboration>
  <bpmn:process id="Process_AccessRequestAsIs" name="Access Request &#38; Approval – As-Is" isExecutable="false">
    <bpmn:documentation>As-Is Access Request &amp; Approval (AS-02), bản chuẩn hóa ngày 21/11/2026. Giữ nguyên logic của bản trước; gộp hai bước "Chuyển yêu cầu đã duyệt đến IT" và gateway hội tụ vào bước IT nhận email và kiểm tra phê duyệt. Quy trình giả lập, chưa được xác minh với doanh nghiệp thực tế.</bpmn:documentation>
    <bpmn:laneSet id="Lane_Employee_Set">
      <bpmn:lane id="Lane_Employee" name="Employee">
        <bpmn:flowNodeRef>AR_Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T01</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T02</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G06</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T05</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T18</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E01</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Manager" name="Manager">
        <bpmn:flowNodeRef>T03</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G01</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T04</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T06</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G02</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T07</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E02</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T08</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G03</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T16</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G07</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T17</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E04</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Security" name="Security">
        <bpmn:flowNodeRef>T09</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G04</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E03</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_IT" name="IT">
        <bpmn:flowNodeRef>T12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G05</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T14</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T15</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="AR_Start" name="Phát sinh nhu cầu cấp quyền">
      <bpmn:outgoing>Flow_AR_Start_T01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="T01" name="Xác định nhu cầu truy cập">
      <bpmn:incoming>Flow_AR_Start_T01</bpmn:incoming>
      <bpmn:outgoing>Flow_T01_T02</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T02" name="Gửi email yêu cầu cấp quyền">
      <bpmn:incoming>Flow_T01_T02</bpmn:incoming>
      <bpmn:outgoing>Flow_T02_T03</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T03" name="Kiểm tra yêu cầu và nhu cầu công việc">
      <bpmn:incoming>Flow_T02_T03</bpmn:incoming>
      <bpmn:incoming>Flow_T05_T03</bpmn:incoming>
      <bpmn:outgoing>Flow_T03_G01</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G01" name="Thông tin yêu cầu đầy đủ?">
      <bpmn:incoming>Flow_T03_G01</bpmn:incoming>
      <bpmn:outgoing>Flow_G01_T06</bpmn:outgoing>
      <bpmn:outgoing>Flow_G01_T04</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T04" name="Yêu cầu bổ sung thông tin qua email">
      <bpmn:incoming>Flow_G01_T04</bpmn:incoming>
      <bpmn:outgoing>Flow_T04_G06</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G06" name="Người yêu cầu tiếp tục bổ sung?">
      <bpmn:documentation>Không = người yêu cầu xác nhận không tiếp tục và đề nghị hủy. Không phản hồi không đồng nghĩa với Không; không tự động hủy theo thời gian.</bpmn:documentation>
      <bpmn:incoming>Flow_T04_G06</bpmn:incoming>
      <bpmn:outgoing>Flow_G06_T05</bpmn:outgoing>
      <bpmn:outgoing>Flow_G06_T17</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T05" name="Bổ sung và gửi lại thông tin">
      <bpmn:incoming>Flow_G06_T05</bpmn:incoming>
      <bpmn:outgoing>Flow_T05_T03</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T06" name="Xác nhận hoặc từ chối yêu cầu">
      <bpmn:documentation>Bản này thể hiện Employee khởi tạo. Nếu Manager là người khởi tạo, cần làm rõ chính sách tự phê duyệt.</bpmn:documentation>
      <bpmn:incoming>Flow_G01_T06</bpmn:incoming>
      <bpmn:outgoing>Flow_T06_G02</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G02" name="Manager phê duyệt?">
      <bpmn:incoming>Flow_T06_G02</bpmn:incoming>
      <bpmn:outgoing>Flow_G02_T08</bpmn:outgoing>
      <bpmn:outgoing>Flow_G02_T07</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T07" name="Thông báo lý do từ chối">
      <bpmn:incoming>Flow_G02_T07</bpmn:incoming>
      <bpmn:outgoing>Flow_T07_E02</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="E02" name="Manager từ chối yêu cầu">
      <bpmn:incoming>Flow_T07_E02</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="T08" name="Tự xác định mức độ nhạy cảm của quyền">
      <bpmn:incoming>Flow_G02_T08</bpmn:incoming>
      <bpmn:outgoing>Flow_T08_G03</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G03" name="Quyền truy cập nhạy cảm?">
      <bpmn:incoming>Flow_T08_G03</bpmn:incoming>
      <bpmn:outgoing>Flow_G03_T09</bpmn:outgoing>
      <bpmn:outgoing>Flow_G03_T12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T09" name="Đánh giá yêu cầu quyền nhạy cảm">
      <bpmn:incoming>Flow_G03_T09</bpmn:incoming>
      <bpmn:outgoing>Flow_T09_G04</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G04" name="Security phê duyệt?">
      <bpmn:incoming>Flow_T09_G04</bpmn:incoming>
      <bpmn:outgoing>Flow_G04_T12</bpmn:outgoing>
      <bpmn:outgoing>Flow_G04_T10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T10" name="Gửi thông báo từ chối">
      <bpmn:incoming>Flow_G04_T10</bpmn:incoming>
      <bpmn:outgoing>Flow_T10_E03</bpmn:outgoing>
      <bpmn:outgoing>Flow_T10_E03</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="E03" name="Security từ chối yêu cầu">
      <bpmn:incoming>Flow_T10_E03</bpmn:incoming>
      <bpmn:incoming>Flow_T10_E03</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="T12" name="Nhận email và kiểm tra phê duyệt bắt buộc">
      <bpmn:documentation>Phê duyệt được chuyển cho IT qua email, từ Manager hoặc Security tùy bên phê duyệt cuối cùng (PP-07, PP-10).</bpmn:documentation>
      <bpmn:incoming>Flow_G03_T12</bpmn:incoming>
      <bpmn:incoming>Flow_G04_T12</bpmn:incoming>
      <bpmn:incoming>Flow_G07_T12</bpmn:incoming>
      <bpmn:outgoing>Flow_T12_G05</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G05" name="Phê duyệt hợp lệ và đầy đủ?">
      <bpmn:incoming>Flow_T12_G05</bpmn:incoming>
      <bpmn:outgoing>Flow_G05_T14</bpmn:outgoing>
      <bpmn:outgoing>Flow_G05_T13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T13" name="Yêu cầu xác minh hoặc bổ sung phê duyệt">
      <bpmn:incoming>Flow_G05_T13</bpmn:incoming>
      <bpmn:outgoing>Flow_T13_T16</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T16" name="Xác minh hoặc bổ sung hồ sơ phê duyệt">
      <bpmn:incoming>Flow_T13_T16</bpmn:incoming>
      <bpmn:outgoing>Flow_T16_G07</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G07" name="Có thể hoàn thiện phê duyệt?">
      <bpmn:documentation>Không = có xác nhận không thể hoàn thiện phê duyệt. Chờ người phê duyệt vắng mặt không mặc nhiên dẫn tới Không.</bpmn:documentation>
      <bpmn:incoming>Flow_T16_G07</bpmn:incoming>
      <bpmn:outgoing>Flow_G07_T12</bpmn:outgoing>
      <bpmn:outgoing>Flow_G07_T17</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T17" name="Thông báo hủy hoặc không thể hoàn thiện yêu cầu">
      <bpmn:incoming>Flow_G06_T17</bpmn:incoming>
      <bpmn:incoming>Flow_G07_T17</bpmn:incoming>
      <bpmn:outgoing>Flow_T17_E04</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="E04" name="Yêu cầu bị hủy hoặc không thể hoàn thiện">
      <bpmn:incoming>Flow_T17_E04</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="T14" name="Thực hiện cấp quyền">
      <bpmn:incoming>Flow_G05_T14</bpmn:incoming>
      <bpmn:outgoing>Flow_T14_T15</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T15" name="Gửi email thông báo kết quả">
      <bpmn:incoming>Flow_T14_T15</bpmn:incoming>
      <bpmn:outgoing>Flow_T15_T18</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T18" name="Tiếp nhận kết quả cấp quyền">
      <bpmn:incoming>Flow_T15_T18</bpmn:incoming>
      <bpmn:outgoing>Flow_T18_E01</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="E01" name="Đã cấp quyền thành công">
      <bpmn:incoming>Flow_T18_E01</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_AR_Start_T01" sourceRef="AR_Start" targetRef="T01" />
    <bpmn:sequenceFlow id="Flow_T01_T02" sourceRef="T01" targetRef="T02" />
    <bpmn:sequenceFlow id="Flow_T02_T03" sourceRef="T02" targetRef="T03" />
