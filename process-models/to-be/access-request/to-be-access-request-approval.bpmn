<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_AccessRequestToBe" targetNamespace="https://elams.example/bpmn" exporter="Camunda Modeler" exporterVersion="5.53.0">
  <bpmn:collaboration id="Collaboration_AccessRequestToBe">
    <bpmn:participant id="Pool_ELAMS" name="Access Request &amp; Approval – To-Be" processRef="Process_AccessRequestToBe" />
    <bpmn:textAnnotation id="Note_Gaps">
      <bpmn:text>GAP-AC-01: biểu mẫu chuẩn. GAP-AC-02: Approval Inbox. GAP-AC-03/04: cấp duyệt theo danh mục quyền. GAP-AC-05: IT chỉ nhận việc khi đủ phê duyệt. GAP-AC-06: lịch sử quyết định. GAP-AC-07: trạng thái chờ bổ sung.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Note_Scope">
      <bpmn:text>Cùng logic phê duyệt với nhánh Sub_Access của Onboarding To-Be. Ủy quyền phê duyệt, escalation và quyền tạm thời là phạm vi mở rộng (Could Have); nhắc hạn duyệt là Should Have (Q-05).</bpmn:text>
    </bpmn:textAnnotation>
  </bpmn:collaboration>
  <bpmn:process id="Process_AccessRequestToBe" name="Access Request &amp; Approval – To-Be" isExecutable="false">
    <bpmn:documentation>To-Be Access Request &amp; Approval (TB-AC-01), bản 0.1 ngày 21/11/2026, mức nghiệp vụ. Quy tắc liên quan: requirements/design-decisions/access-request-to-be-design-decisions.md (BR-AC-01 đến BR-AC-06). Danh mục quyền nhạy cảm, thẩm quyền và SLA là giả định chưa được xác nhận. Không phải mô hình thực thi.</bpmn:documentation>
    <bpmn:laneSet id="Lane_Requester_Set">
      <bpmn:lane id="Lane_Requester" name="Người yêu cầu">
        <bpmn:flowNodeRef>AR_Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>R01</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>R02</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>RG01</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_Cancel</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Manager" name="Manager">
        <bpmn:flowNodeRef>M01</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>MG01</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_RejMgr</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Security" name="Security">
        <bpmn:flowNodeRef>SE01</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SG02</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_RejSec</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ELAMS" name="ELAMS">
        <bpmn:flowNodeRef>S01</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SG01</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S02</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AR_End</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_IT" name="IT">
        <bpmn:flowNodeRef>I01</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IG01</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>I02</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="AR_Start" name="Phát sinh nhu cầu cấp quyền">
      <bpmn:outgoing>Flow_AR_Start_R01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="R01" name="Tạo yêu cầu cấp quyền trên biểu mẫu">
      <bpmn:documentation>GAP-AC-01. Biểu mẫu có trường bắt buộc: hệ thống, quyền cần cấp, lý do sử dụng. Không gửi được khi thiếu trường bắt buộc (BR-AC-01).</bpmn:documentation>
      <bpmn:incoming>Flow_AR_Start_R01</bpmn:incoming>
      <bpmn:outgoing>Flow_R01_M01</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="M01" name="Xét duyệt yêu cầu trong Approval Inbox">
      <bpmn:documentation>GAP-AC-02. Manager thấy yêu cầu, lý do và cấp phê duyệt dự kiến. Từ chối hoặc yêu cầu bổ sung phải nhập lý do (BR-AC-02).</bpmn:documentation>
      <bpmn:incoming>Flow_R01_M01</bpmn:incoming>
      <bpmn:incoming>Flow_RG01_M01</bpmn:incoming>
      <bpmn:outgoing>Flow_M01_MG01</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="MG01" name="Quyết định của Manager?">
      <bpmn:incoming>Flow_M01_MG01</bpmn:incoming>
      <bpmn:outgoing>Flow_MG01_S01</bpmn:outgoing>
      <bpmn:outgoing>Flow_MG01_R02</bpmn:outgoing>
      <bpmn:outgoing>Flow_MG01_E_RejMgr</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="E_RejMgr" name="Manager từ chối – đã thông báo người yêu cầu">
      <bpmn:incoming>Flow_MG01_E_RejMgr</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="R02" name="Bổ sung thông tin hoặc hủy yêu cầu">
      <bpmn:documentation>GAP-AC-07. Yêu cầu ở trạng thái Chờ bổ sung. Không phản hồi không đồng nghĩa với hủy; không tự động hủy theo thời gian khi chưa có chính sách (Q-12).</bpmn:documentation>
      <bpmn:incoming>Flow_MG01_R02</bpmn:incoming>
      <bpmn:outgoing>Flow_R02_RG01</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="RG01" name="Gửi lại?">
      <bpmn:incoming>Flow_R02_RG01</bpmn:incoming>
      <bpmn:outgoing>Flow_RG01_M01</bpmn:outgoing>
      <bpmn:outgoing>Flow_RG01_E_Cancel</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="E_Cancel" name="Người yêu cầu hủy yêu cầu">
      <bpmn:incoming>Flow_RG01_E_Cancel</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="S01" name="Xác định cấp phê duyệt theo danh mục quyền">
      <bpmn:documentation>GAP-AC-03. Mức nhạy cảm lấy từ danh mục quyền, không do người duyệt tự xác định (BR-AC-03). Giả định: quyền dữ liệu tài chính và quyền quản trị hệ thống là nhạy cảm (Q-06, Q-07).</bpmn:documentation>
      <bpmn:incoming>Flow_MG01_S01</bpmn:incoming>
      <bpmn:outgoing>Flow_S01_SG01</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="SG01" name="Quyền nhạy cảm?">
      <bpmn:incoming>Flow_S01_SG01</bpmn:incoming>
      <bpmn:outgoing>Flow_SG01_SE01</bpmn:outgoing>
      <bpmn:outgoing>Flow_SG01_I01</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="SE01" name="Xét duyệt quyền nhạy cảm">
      <bpmn:documentation>GAP-AC-04. Security chỉ nhận yêu cầu sau khi Manager đã phê duyệt. Từ chối phải nhập lý do.</bpmn:documentation>
      <bpmn:incoming>Flow_SG01_SE01</bpmn:incoming>
      <bpmn:outgoing>Flow_SE01_SG02</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="SG02" name="Security phê duyệt?">
      <bpmn:incoming>Flow_SE01_SG02</bpmn:incoming>
      <bpmn:outgoing>Flow_SG02_I01</bpmn:outgoing>
      <bpmn:outgoing>Flow_SG02_E_RejSec</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="E_RejSec" name="Security từ chối – đã thông báo người yêu cầu">
      <bpmn:incoming>Flow_SG02_E_RejSec</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="I01" name="Chuẩn bị tài khoản và cấp quyền trên hệ thống đích">
      <bpmn:documentation>GAP-AC-05, KPI-03. Nhiệm vụ cấp quyền chỉ được tạo cho IT khi đã đủ phê duyệt bắt buộc (BR-AC-04, Q-15). Đã có tài khoản thì dùng lại, chưa có thì tạo mới; không tạo trùng tài khoản. Thao tác trên hệ thống đích được mô phỏng.</bpmn:documentation>
      <bpmn:incoming>Flow_SG01_I01</bpmn:incoming>
      <bpmn:incoming>Flow_SG02_I01</bpmn:incoming>
      <bpmn:incoming>Flow_I02_I01</bpmn:incoming>
      <bpmn:outgoing>Flow_I01_IG01</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="IG01" name="Cấp quyền thành công?">
      <bpmn:incoming>Flow_I01_IG01</bpmn:incoming>
      <bpmn:outgoing>Flow_IG01_S02</bpmn:outgoing>
      <bpmn:outgoing>Flow_IG01_I02</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="I02" name="Khắc phục lỗi cấp quyền">
      <bpmn:incoming>Flow_IG01_I02</bpmn:incoming>
      <bpmn:outgoing>Flow_I02_I01</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="S02" name="Đóng yêu cầu và thông báo kết quả">
      <bpmn:documentation>GAP-AC-06. Lịch sử yêu cầu lưu người duyệt, kết quả, lý do và thời điểm của từng quyết định (BR-AC-05, KPI-06).</bpmn:documentation>
      <bpmn:incoming>Flow_IG01_S02</bpmn:incoming>
      <bpmn:outgoing>Flow_S02_AR_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="AR_End" name="Quyền đã được cấp">
      <bpmn:incoming>Flow_S02_AR_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_AR_Start_R01" sourceRef="AR_Start" targetRef="R01" />
    <bpmn:sequenceFlow id="Flow_R01_M01" sourceRef="R01" targetRef="M01" />
    <bpmn:sequenceFlow id="Flow_M01_MG01" sourceRef="M01" targetRef="MG01" />
    <bpmn:sequenceFlow id="Flow_S01_SG01" sourceRef="S01" targetRef="SG01" />
    <bpmn:sequenceFlow id="Flow_SE01_SG02" sourceRef="SE01" targetRef="SG02" />
    <bpmn:sequenceFlow id="Flow_I01_IG01" sourceRef="I01" targetRef="IG01" />
    <bpmn:sequenceFlow id="Flow_S02_AR_End" sourceRef="S02" targetRef="AR_End" />
    <bpmn:sequenceFlow id="Flow_MG01_S01" name="Phê duyệt" sourceRef="MG01" targetRef="S01" />
    <bpmn:sequenceFlow id="Flow_MG01_R02" name="Cần bổ sung" sourceRef="MG01" targetRef="R02" />
    <bpmn:sequenceFlow id="Flow_MG01_E_RejMgr" name="Từ chối" sourceRef="MG01" targetRef="E_RejMgr" />
    <bpmn:sequenceFlow id="Flow_R02_RG01" sourceRef="R02" targetRef="RG01" />
    <bpmn:sequenceFlow id="Flow_RG01_M01" name="Có" sourceRef="RG01" targetRef="M01" />
    <bpmn:sequenceFlow id="Flow_RG01_E_Cancel" name="Không" sourceRef="RG01" targetRef="E_Cancel" />
    <bpmn:sequenceFlow id="Flow_SG01_SE01" name="Có" sourceRef="SG01" targetRef="SE01" />
    <bpmn:sequenceFlow id="Flow_SG01_I01" name="Không" sourceRef="SG01" targetRef="I01" />
    <bpmn:sequenceFlow id="Flow_SG02_I01" name="Có" sourceRef="SG02" targetRef="I01" />
    <bpmn:sequenceFlow id="Flow_SG02_E_RejSec" name="Không" sourceRef="SG02" targetRef="E_RejSec" />
    <bpmn:sequenceFlow id="Flow_IG01_S02" name="Có" sourceRef="IG01" targetRef="S02" />
    <bpmn:sequenceFlow id="Flow_IG01_I02" name="Không" sourceRef="IG01" targetRef="I02" />
    <bpmn:sequenceFlow id="Flow_I02_I01" sourceRef="I02" targetRef="I01" />
  </bpmn:process>
