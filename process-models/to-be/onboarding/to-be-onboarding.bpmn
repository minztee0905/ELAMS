<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_OnboardingToBe" targetNamespace="https://elams.example/bpmn" exporter="Camunda Modeler" exporterVersion="5.53.0">
  <bpmn:message id="Message_StartDateChange" name="Đề nghị thay đổi ngày bắt đầu làm việc" />
  <bpmn:collaboration id="Collaboration_OnboardingToBe">
    <bpmn:participant id="Pool_ELAMS" name="Employee Onboarding – To-Be" processRef="Process_OnboardingToBe" />
    <bpmn:textAnnotation id="Note_Gaps">
      <bpmn:text>GAP-ON-01/04: yêu cầu tập trung và kiểm tra dữ liệu. GAP-ON-02/03: nhiệm vụ, người phụ trách, hạn và tiến độ. GAP-ON-05: lịch sử cấp phát. GAP-ON-06: kiểm soát hoàn tất.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Note_Scope">
      <bpmn:text>Mở dấu + để xem chi tiết từng nhánh. IT thao tác trên hệ thống đích (mô phỏng); ELAMS điều phối và kiểm soát. Thông báo tự động, escalation và cấu hình mẫu là phần mở rộng.</bpmn:text>
    </bpmn:textAnnotation>
  </bpmn:collaboration>
  <bpmn:process id="Process_OnboardingToBe" name="Employee Onboarding – To-Be" isExecutable="false">
    <bpmn:documentation>To-Be Onboarding (TB-ON-01), bản 0.5 ngày 21/11/2026, mức nghiệp vụ. Quy tắc liên quan: requirements/design-decisions/onboarding-to-be-design-decisions.md (BR-ON-01 đến BR-ON-10). Cơ chế thực thi (worker, retry, idempotency) nằm ở implementation/workflow/onboarding-technical-notes.md. Thẩm quyền, SLA, mẫu nhiệm vụ và chính sách chưa chốt là đề xuất. Không phải mô hình thực thi.</bpmn:documentation>
    <bpmn:laneSet id="Lane_HR_Set">
      <bpmn:lane id="Lane_HR" name="HR">
        <bpmn:flowNodeRef>ON_Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>H01</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>H02</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>H04</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Wait_NewData</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>H03</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Sub_DateChange</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ELAMS" name="ELAMS">
        <bpmn:flowNodeRef>S01</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G01</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S03</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AND_Split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Sub_Access</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Sub_Devices</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AND_Join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S06</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G02</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S07</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ON_End</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="ON_Start" name="Nhân viên đã xác nhận nhận việc">
      <bpmn:outgoing>Flow_ON_Start_H01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="H01" name="Nhập và gửi yêu cầu onboarding">
      <bpmn:incoming>Flow_ON_Start_H01</bpmn:incoming>
      <bpmn:outgoing>Flow_H01_S01</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="S01" name="Kiểm tra dữ liệu yêu cầu">
      <bpmn:documentation>GAP-ON-04. Kiểm tra trường bắt buộc, ngày hợp lệ, phòng ban/chức danh và mẫu nhiệm vụ áp dụng.</bpmn:documentation>
      <bpmn:incoming>Flow_H01_S01</bpmn:incoming>
      <bpmn:incoming>Flow_H02_S01</bpmn:incoming>
      <bpmn:outgoing>Flow_S01_G01</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="G01" name="Dữ liệu hợp lệ?">
      <bpmn:incoming>Flow_S01_G01</bpmn:incoming>
      <bpmn:outgoing>Flow_G01_S03</bpmn:outgoing>
      <bpmn:outgoing>Flow_G01_H02</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="H02" name="Sửa và gửi lại yêu cầu">
      <bpmn:incoming>Flow_G01_H02</bpmn:incoming>
      <bpmn:outgoing>Flow_H02_S01</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="S03" name="Lưu yêu cầu, tạo nhiệm vụ, gán người phụ trách và hạn">
      <bpmn:documentation>GAP-ON-01/02/03. Tạo nhiệm vụ theo mẫu; yêu cầu chỉ được coi là khởi tạo xong khi đã tạo đủ nhiệm vụ bắt buộc. Tiến độ và người phụ trách hiển thị tập trung cho HR.</bpmn:documentation>
      <bpmn:incoming>Flow_G01_S03</bpmn:incoming>
      <bpmn:outgoing>Flow_S03_AND_Split</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="AND_Split" name="">
      <bpmn:incoming>Flow_S03_AND_Split</bpmn:incoming>
      <bpmn:outgoing>Flow_AND_Split_Sub_Access</bpmn:outgoing>
      <bpmn:outgoing>Flow_AND_Split_Sub_Devices</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:subProcess id="Sub_Access" name="Phê duyệt và cấp từng quyền">
      <bpmn:documentation>BR-ON-01/02/09. Xử lý lần lượt từng quyền trong danh sách (Sequential Multi-instance). Mỗi quyền kết thúc COMPLETED hoặc REJECTED (chỉ quyền không bắt buộc); BLOCKED là trạng thái chờ, chưa kết thúc.</bpmn:documentation>
      <bpmn:incoming>Flow_AND_Split_Sub_Access</bpmn:incoming>
      <bpmn:outgoing>Flow_Sub_Access_AND_Join</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics isSequential="true" />
      <bpmn:laneSet id="Acc_Lane_Manager_Set">
        <bpmn:lane id="Acc_Lane_Manager" name="Manager">
          <bpmn:flowNodeRef>A_Start</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>A01</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>AG01</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>A04</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="Acc_Lane_ELAMS" name="ELAMS">
          <bpmn:flowNodeRef>A05</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>AG02</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>A11</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>AG05</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>A_End</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>A03</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>AG_Optional</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>A_EndRejected</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="Acc_Lane_Security" name="Security">
          <bpmn:flowNodeRef>A06</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>AG03</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="Acc_Lane_IT" name="IT">
          <bpmn:flowNodeRef>AT</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>A09</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>A14</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="A_Start" name="Bắt đầu xử lý một quyền">
        <bpmn:outgoing>Flow_A_Start_A01</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="A01" name="Xét duyệt nhu cầu quyền">
        <bpmn:incoming>Flow_A_Start_A01</bpmn:incoming>
        <bpmn:incoming>Flow_A04_A01</bpmn:incoming>
        <bpmn:outgoing>Flow_A01_AG01</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="AG01" name="Manager phê duyệt?">
        <bpmn:incoming>Flow_A01_AG01</bpmn:incoming>
        <bpmn:outgoing>Flow_AG01_A05</bpmn:outgoing>
        <bpmn:outgoing>Flow_AG01_A03</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:userTask id="A04" name="Điều chỉnh nhu cầu và gửi lại (quyền BLOCKED)">
        <bpmn:documentation>BR-ON-01/02. Quyền bắt buộc bị từ chối hoặc chưa xác định được tính bắt buộc: quyền ở trạng thái BLOCKED, chưa kết thúc. Quyền phía sau trong danh sách phải chờ (BR-ON-09).</bpmn:documentation>
        <bpmn:incoming>Flow_AG_Optional_A04</bpmn:incoming>
        <bpmn:outgoing>Flow_A04_A01</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="A05" name="Phân loại quyền theo danh mục">
        <bpmn:incoming>Flow_AG01_A05</bpmn:incoming>
        <bpmn:outgoing>Flow_A05_AG02</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:exclusiveGateway id="AG02" name="Quyền nhạy cảm?">
        <bpmn:incoming>Flow_A05_AG02</bpmn:incoming>
        <bpmn:outgoing>Flow_AG02_A06</bpmn:outgoing>
        <bpmn:outgoing>Flow_AG02_AT</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:userTask id="A06" name="Xét duyệt quyền nhạy cảm">
        <bpmn:incoming>Flow_AG02_A06</bpmn:incoming>
        <bpmn:outgoing>Flow_A06_AG03</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="AG03" name="Security phê duyệt?">
        <bpmn:incoming>Flow_A06_AG03</bpmn:incoming>
        <bpmn:outgoing>Flow_AG03_AT</bpmn:outgoing>
        <bpmn:outgoing>Flow_AG03_A03</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:userTask id="AT" name="Chuẩn bị tài khoản: dùng lại hoặc tạo mới">
        <bpmn:documentation>BR-ON-10. IT kiểm tra tài khoản của đúng nhân viên trên hệ thống đích; đã có thì dùng lại, chưa có thì tạo mới. Không kiểm tra được không có nghĩa là chưa có tài khoản. Không tạo trùng tài khoản.</bpmn:documentation>
        <bpmn:incoming>Flow_AG02_AT</bpmn:incoming>
        <bpmn:incoming>Flow_AG03_AT</bpmn:incoming>
        <bpmn:incoming>Flow_A14_AT</bpmn:incoming>
        <bpmn:outgoing>Flow_AT_A09</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="A09" name="Cấp quyền và cập nhật kết quả">
        <bpmn:documentation>Chỉ đến được bước này sau khi đủ phê duyệt bắt buộc (KPI-03). Thao tác trên hệ thống đích được mô phỏng.</bpmn:documentation>
        <bpmn:incoming>Flow_AT_A09</bpmn:incoming>
        <bpmn:outgoing>Flow_A09_A11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="A11" name="Kiểm tra kết quả và hiệu lực phê duyệt">
        <bpmn:incoming>Flow_A09_A11</bpmn:incoming>
        <bpmn:outgoing>Flow_A11_AG05</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:exclusiveGateway id="AG05" name="Cấp quyền hợp lệ?">
        <bpmn:incoming>Flow_A11_AG05</bpmn:incoming>
        <bpmn:outgoing>Flow_AG05_A_End</bpmn:outgoing>
        <bpmn:outgoing>Flow_AG05_A14</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:userTask id="A14" name="Khắc phục lỗi cấp quyền (quyền BLOCKED)">
        <bpmn:incoming>Flow_AG05_A14</bpmn:incoming>
        <bpmn:outgoing>Flow_A14_AT</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="A_End" name="COMPLETED – Quyền đã được cấp">
        <bpmn:incoming>Flow_AG05_A_End</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:serviceTask id="A03" name="Ghi nhận quyết định từ chối và lý do">
        <bpmn:documentation>REQ-007: lý do từ chối là bắt buộc và được lưu vào lịch sử phê duyệt.</bpmn:documentation>
        <bpmn:incoming>Flow_AG01_A03</bpmn:incoming>
        <bpmn:incoming>Flow_AG03_A03</bpmn:incoming>
        <bpmn:outgoing>Flow_A03_AG_Optional</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:exclusiveGateway id="AG_Optional" name="Quyền không bắt buộc?">
        <bpmn:incoming>Flow_A03_AG_Optional</bpmn:incoming>
        <bpmn:outgoing>Flow_AG_Optional_A_EndRejected</bpmn:outgoing>
        <bpmn:outgoing>Flow_AG_Optional_A04</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:endEvent id="A_EndRejected" name="REJECTED – Quyền không bắt buộc bị từ chối">
        <bpmn:incoming>Flow_AG_Optional_A_EndRejected</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_A_Start_A01" sourceRef="A_Start" targetRef="A01" />
      <bpmn:sequenceFlow id="Flow_A01_AG01" sourceRef="A01" targetRef="AG01" />
      <bpmn:sequenceFlow id="Flow_A05_AG02" sourceRef="A05" targetRef="AG02" />
      <bpmn:sequenceFlow id="Flow_A06_AG03" sourceRef="A06" targetRef="AG03" />
      <bpmn:sequenceFlow id="Flow_AT_A09" sourceRef="AT" targetRef="A09" />
      <bpmn:sequenceFlow id="Flow_A09_A11" sourceRef="A09" targetRef="A11" />
      <bpmn:sequenceFlow id="Flow_A11_AG05" sourceRef="A11" targetRef="AG05" />
      <bpmn:sequenceFlow id="Flow_A03_AG_Optional" sourceRef="A03" targetRef="AG_Optional" />
      <bpmn:sequenceFlow id="Flow_AG01_A05" name="Có" sourceRef="AG01" targetRef="A05" />
      <bpmn:sequenceFlow id="Flow_AG01_A03" name="Không" sourceRef="AG01" targetRef="A03" />
      <bpmn:sequenceFlow id="Flow_AG02_A06" name="Có" sourceRef="AG02" targetRef="A06" />
      <bpmn:sequenceFlow id="Flow_AG02_AT" name="Không" sourceRef="AG02" targetRef="AT" />
      <bpmn:sequenceFlow id="Flow_AG03_AT" name="Có" sourceRef="AG03" targetRef="AT" />
      <bpmn:sequenceFlow id="Flow_AG03_A03" name="Không" sourceRef="AG03" targetRef="A03" />
      <bpmn:sequenceFlow id="Flow_AG05_A_End" name="Có" sourceRef="AG05" targetRef="A_End" />
      <bpmn:sequenceFlow id="Flow_AG05_A14" name="Không" sourceRef="AG05" targetRef="A14" />
      <bpmn:sequenceFlow id="Flow_A14_AT" sourceRef="A14" targetRef="AT" />
      <bpmn:sequenceFlow id="Flow_AG_Optional_A_EndRejected" name="Có" sourceRef="AG_Optional" targetRef="A_EndRejected" />
      <bpmn:sequenceFlow id="Flow_AG_Optional_A04" name="Không" sourceRef="AG_Optional" targetRef="A04" />
      <bpmn:sequenceFlow id="Flow_A04_A01" sourceRef="A04" targetRef="A01" />
    </bpmn:subProcess>
    <bpmn:subProcess id="Sub_Devices" name="Cấp phát và xác nhận thiết bị">
      <bpmn:incoming>Flow_AND_Split_Sub_Devices</bpmn:incoming>
      <bpmn:outgoing>Flow_Sub_Devices_AND_Join</bpmn:outgoing>
      <bpmn:laneSet id="Dev_Lane_Employee_Set">
        <bpmn:lane id="Dev_Lane_Employee" name="Employee">
          <bpmn:flowNodeRef>D06</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="Dev_Lane_IT" name="IT">
          <bpmn:flowNodeRef>D_Start</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>D01</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>DG01</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>D02</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>D04</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>D05</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>D07</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="Dev_Lane_ELAMS" name="ELAMS">
          <bpmn:flowNodeRef>D08</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>DG02</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>D_End</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="D_Start" name="Có nhiệm vụ cấp thiết bị">
        <bpmn:outgoing>Flow_D_Start_D01</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="D01" name="Kiểm tra thiết bị phù hợp để cấp">
        <bpmn:incoming>Flow_D_Start_D01</bpmn:incoming>
        <bpmn:incoming>Flow_D04_D01</bpmn:incoming>
        <bpmn:outgoing>Flow_D01_DG01</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="DG01" name="Có thiết bị phù hợp?">
        <bpmn:incoming>Flow_D01_DG01</bpmn:incoming>
        <bpmn:outgoing>Flow_DG01_D05</bpmn:outgoing>
        <bpmn:outgoing>Flow_DG01_D02</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:userTask id="D02" name="Ghi nhận thiếu thiết bị và lý do chờ">
        <bpmn:documentation>BR-ON-03. Nhiệm vụ thiết bị giữ trạng thái chờ; không kiểm tra lặp lại khi chưa có thay đổi.</bpmn:documentation>
        <bpmn:incoming>Flow_DG01_D02</bpmn:incoming>
        <bpmn:outgoing>Flow_D02_D04</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="D04" name="Xác nhận đã có thiết bị phù hợp hoặc thay thế">
        <bpmn:incoming>Flow_D02_D04</bpmn:incoming>
        <bpmn:outgoing>Flow_D04_D01</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:manualTask id="D05" name="Chuẩn bị và bàn giao thiết bị">
        <bpmn:incoming>Flow_DG01_D05</bpmn:incoming>
        <bpmn:outgoing>Flow_D05_D06</bpmn:outgoing>
      </bpmn:manualTask>
      <bpmn:manualTask id="D06" name="Ký biên bản nhận thiết bị">
        <bpmn:documentation>Giả định cần xác nhận (Q-19): nhân viên ký biên bản, IT đính kèm lên ELAMS.</bpmn:documentation>
        <bpmn:incoming>Flow_D05_D06</bpmn:incoming>
        <bpmn:outgoing>Flow_D06_D07</bpmn:outgoing>
      </bpmn:manualTask>
      <bpmn:userTask id="D07" name="Ghi nhận bàn giao và đính kèm biên bản">
        <bpmn:incoming>Flow_D06_D07</bpmn:incoming>
        <bpmn:incoming>Flow_DG02_D07</bpmn:incoming>
        <bpmn:outgoing>Flow_D07_D08</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="D08" name="Kiểm tra thông tin và biên bản bàn giao">
        <bpmn:documentation>SRS-ON-01: mã thiết bị, người nhận, thời gian bàn giao, tình trạng, mã biên bản, người giao và người ghi nhận.</bpmn:documentation>
        <bpmn:incoming>Flow_D07_D08</bpmn:incoming>
        <bpmn:outgoing>Flow_D08_DG02</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:exclusiveGateway id="DG02" name="Thông tin bàn giao hợp lệ?">
        <bpmn:incoming>Flow_D08_DG02</bpmn:incoming>
        <bpmn:outgoing>Flow_DG02_D_End</bpmn:outgoing>
        <bpmn:outgoing>Flow_DG02_D07</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:endEvent id="D_End" name="COMPLETED – Thiết bị đã bàn giao và ghi nhận">
        <bpmn:incoming>Flow_DG02_D_End</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_D_Start_D01" sourceRef="D_Start" targetRef="D01" />
      <bpmn:sequenceFlow id="Flow_D01_DG01" sourceRef="D01" targetRef="DG01" />
      <bpmn:sequenceFlow id="Flow_D05_D06" sourceRef="D05" targetRef="D06" />
      <bpmn:sequenceFlow id="Flow_D06_D07" sourceRef="D06" targetRef="D07" />
      <bpmn:sequenceFlow id="Flow_D07_D08" sourceRef="D07" targetRef="D08" />
      <bpmn:sequenceFlow id="Flow_D08_DG02" sourceRef="D08" targetRef="DG02" />
      <bpmn:sequenceFlow id="Flow_D02_D04" sourceRef="D02" targetRef="D04" />
      <bpmn:sequenceFlow id="Flow_DG01_D05" name="Có" sourceRef="DG01" targetRef="D05" />
      <bpmn:sequenceFlow id="Flow_DG01_D02" name="Không" sourceRef="DG01" targetRef="D02" />
      <bpmn:sequenceFlow id="Flow_D04_D01" sourceRef="D04" targetRef="D01" />
      <bpmn:sequenceFlow id="Flow_DG02_D_End" name="Có" sourceRef="DG02" targetRef="D_End" />
      <bpmn:sequenceFlow id="Flow_DG02_D07" name="Không" sourceRef="DG02" targetRef="D07" />
    </bpmn:subProcess>
    <bpmn:parallelGateway id="AND_Join" name="">
      <bpmn:incoming>Flow_Sub_Access_AND_Join</bpmn:incoming>
      <bpmn:incoming>Flow_Sub_Devices_AND_Join</bpmn:incoming>
      <bpmn:outgoing>Flow_AND_Join_S06</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="S06" name="Kiểm tra điều kiện hoàn tất theo dữ liệu mới nhất">
      <bpmn:documentation>BR-ON-06. Kiểm tra từng nhiệm vụ bắt buộc, kết quả từng quyền, quyết định từ chối quyền tùy chọn, bàn giao thiết bị và hiệu lực phê duyệt. Hai nhánh cùng kết thúc chưa chứng minh onboarding thành công.</bpmn:documentation>
      <bpmn:incoming>Flow_AND_Join_S06</bpmn:incoming>
      <bpmn:incoming>Flow_Wait_NewData_S06</bpmn:incoming>
      <bpmn:outgoing>Flow_S06_G02</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="G02" name="Đủ điều kiện hoàn tất?">
      <bpmn:incoming>Flow_S06_G02</bpmn:incoming>
      <bpmn:outgoing>Flow_G02_H03</bpmn:outgoing>
      <bpmn:outgoing>Flow_G02_H04</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="H04" name="Phối hợp xử lý điều kiện còn thiếu">
      <bpmn:documentation>BR-ON-07. Yêu cầu ở trạng thái chờ; ELAMS hiển thị điều kiện còn thiếu.</bpmn:documentation>
      <bpmn:incoming>Flow_G02_H04</bpmn:incoming>
      <bpmn:outgoing>Flow_H04_Wait_NewData</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:intermediateCatchEvent id="Wait_NewData" name="Có cập nhật dữ liệu liên quan">
      <bpmn:documentation>BR-ON-07. Xem dữ liệu hoặc ghi lịch sử không được tính là cập nhật.</bpmn:documentation>
      <bpmn:incoming>Flow_H04_Wait_NewData</bpmn:incoming>
      <bpmn:outgoing>Flow_Wait_NewData_S06</bpmn:outgoing>
      <bpmn:conditionalEventDefinition id="Wait_NewData_Def">
        <bpmn:condition xsi:type="bpmn:tFormalExpression">Dữ liệu liên quan đến điều kiện hoàn tất được cập nhật sau lần kiểm tra trước</bpmn:condition>
      </bpmn:conditionalEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="H03" name="Rà soát và xác nhận đóng onboarding">
      <bpmn:incoming>Flow_G02_H03</bpmn:incoming>
      <bpmn:outgoing>Flow_H03_S07</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="S07" name="Cập nhật trạng thái Completed">
      <bpmn:documentation>BR-ON-08. Ghi Completed và lịch sử sau khi HR xác nhận. Nếu điều kiện thay đổi ngay trước khi ghi, yêu cầu quay về trạng thái chờ thay vì đóng.</bpmn:documentation>
      <bpmn:incoming>Flow_H03_S07</bpmn:incoming>
      <bpmn:outgoing>Flow_S07_ON_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="ON_End" name="Onboarding hoàn tất">
      <bpmn:incoming>Flow_S07_ON_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:subProcess id="Sub_DateChange" name="Thay đổi ngày bắt đầu làm việc" triggeredByEvent="true">
      <bpmn:laneSet id="Date_Lane_HR_Set">
        <bpmn:lane id="Date_Lane_HR" name="HR">
          <bpmn:flowNodeRef>C_Start</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>C01</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="Date_Lane_ELAMS" name="ELAMS">
          <bpmn:flowNodeRef>C02</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>CG01</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>C04</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>C_End</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>C_NoChange</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="C_Start" name="Nhận đề nghị đổi ngày bắt đầu" isInterrupting="false">
        <bpmn:outgoing>Flow_C_Start_C01</bpmn:outgoing>
        <bpmn:messageEventDefinition id="C_Start_Def" messageRef="Message_StartDateChange" />
      </bpmn:startEvent>
      <bpmn:userTask id="C01" name="Nhập ngày mới và lý do thay đổi">
        <bpmn:incoming>Flow_C_Start_C01</bpmn:incoming>
        <bpmn:outgoing>Flow_C01_C02</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="C02" name="Kiểm tra chính sách và xác định nhiệm vụ bị ảnh hưởng">
        <bpmn:documentation>BR-ON-04. Chỉ nhiệm vụ chưa hoàn thành bị ảnh hưởng; không tự mở lại nhiệm vụ đã xong; không tự cấp lại hay thu hồi quyền vì đổi ngày.</bpmn:documentation>
        <bpmn:incoming>Flow_C01_C02</bpmn:incoming>
        <bpmn:outgoing>Flow_C02_CG01</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:exclusiveGateway id="CG01" name="Thay đổi hợp lệ?">
        <bpmn:incoming>Flow_C02_CG01</bpmn:incoming>
        <bpmn:outgoing>Flow_CG01_C04</bpmn:outgoing>
        <bpmn:outgoing>Flow_CG01_C_NoChange</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:serviceTask id="C04" name="Cập nhật ngày, hạn nhiệm vụ và nhắc việc liên quan">
        <bpmn:documentation>BR-ON-05. Thay đổi chỉ hoàn tất khi hạn và nhắc việc liên quan đã cập nhật theo ngày mới.</bpmn:documentation>
        <bpmn:incoming>Flow_CG01_C04</bpmn:incoming>
        <bpmn:outgoing>Flow_C04_C_End</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="C_End" name="Ngày, hạn và nhắc việc đã cập nhật">
        <bpmn:incoming>Flow_C04_C_End</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:endEvent id="C_NoChange" name="Từ chối thay đổi, giữ dữ liệu hiện hành">
        <bpmn:incoming>Flow_CG01_C_NoChange</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_C_Start_C01" sourceRef="C_Start" targetRef="C01" />
      <bpmn:sequenceFlow id="Flow_C01_C02" sourceRef="C01" targetRef="C02" />
      <bpmn:sequenceFlow id="Flow_C02_CG01" sourceRef="C02" targetRef="CG01" />
