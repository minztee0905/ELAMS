      <bpmn:outgoing>Flow_Access_16</bpmn:outgoing>
      <bpmn:outgoing>Flow_Access_17</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T09" name="Đánh giá yêu cầu quyền nhạy cảm">
      <bpmn:incoming>Flow_Access_16</bpmn:incoming>
      <bpmn:outgoing>Flow_Access_18</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G04" name="Security phê duyệt?">
      <bpmn:incoming>Flow_Access_18</bpmn:incoming>
      <bpmn:outgoing>Flow_Access_19</bpmn:outgoing>
      <bpmn:outgoing>Flow_Access_20</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T10" name="Gửi thông báo từ chối">
