      <bpmn:outgoing>Flow_Access_34</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="E01" name="Đã cấp quyền thành công">
      <bpmn:incoming>Flow_Access_34</bpmn:incoming>
    </bpmn:endEvent>
