<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_AccessAsIs" targetNamespace="https://elams.example/bpmn" exporter="Camunda Modeler" exporterVersion="5.53.0">
  <bpmn:collaboration id="Collaboration_AccessAsIs">
    <bpmn:participant id="Pool_TechNova" name="TechNova - Access Request &#38; Approval (As-Is)" processRef="Process_AccessAsIs" />
    <bpmn:textAnnotation id="Note_Cancellation">
      <bpmn:text>Giả định cần xác nhận: chỉ kết thúc E04 khi có xác nhận hủy hoặc không thể hoàn thiện. Không tự động hủy vì quá hạn. T11 nằm ở hai lane theo bên phê duyệt cuối cùng.</bpmn:text>
    </bpmn:textAnnotation>
  </bpmn:collaboration>
  <bpmn:process id="Process_AccessAsIs" name="AS-02 - Access Request &#38; Approval (As-Is)" isExecutable="false">
    <bpmn:documentation>Quy trình As-Is giả lập, bản nháp cần BA xác nhận. Nguồn: tài liệu as-is-process-analysis.md, AS-02; danh sách T01–T15, G01–G05 và E01–E04 do BA cung cấp. T11 được thể hiện ở hai lane bằng T11_Manager và T11_Security, mỗi lần xử lý chỉ đi một nhánh. G06, G07, T16, T17 và T18 bổ sung để làm rõ hủy/không thể hoàn thiện và nhận kết quả. Giả định cần xác nhận: người yêu cầu có thể đề nghị hủy khi không tiếp tục bổ sung; Manager thông báo kết thúc khi có xác nhận hủy hoặc không thể hoàn thiện. Không tự động hủy do quá hạn; quyền hủy, thời hạn chờ và ủy quyền cần làm rõ. Khi hồ sơ/phê duyệt thay đổi, Manager kiểm tra lại và Security xét duyệt lại nếu quyền nhạy cảm. Yêu cầu mới sau một lần từ chối là một phiên xử lý mới. Đây là sơ đồ nghiệp vụ, chưa cấu hình chạy trên engine.</bpmn:documentation>
    <bpmn:laneSet id="Lanes_Access">
      <bpmn:lane id="Lane_IT" name="IT">
        <bpmn:flowNodeRef>Gateway_09zz158</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G05</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T14</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T15</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Security" name="Security">
        <bpmn:flowNodeRef>T09</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G04</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T11_Security</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E03</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Manager" name="Manager">
