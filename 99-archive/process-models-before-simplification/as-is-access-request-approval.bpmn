      <bpmn:outgoing>Flow_Access_28</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G07" name="Có thể hoàn thiện phê duyệt?">
      <bpmn:documentation>Không = có xác nhận không thể hoàn thiện phê duyệt. Việc chờ người phê duyệt vắng mặt không mặc nhiên dẫn tới kết quả Không.</bpmn:documentation>
      <bpmn:incoming>Flow_Access_28</bpmn:incoming>
      <bpmn:outgoing>Flow_Access_29</bpmn:outgoing>
      <bpmn:outgoing>Flow_Access_30</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T17" name="Thông báo hủy hoặc không thể hoàn thiện yêu cầu">
      <bpmn:incoming>Flow_Access_09</bpmn:incoming>
      <bpmn:incoming>Flow_Access_30</bpmn:incoming>
      <bpmn:outgoing>Flow_Access_31</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="E04" name="Yêu cầu bị hủy hoặc không thể hoàn thiện">
      <bpmn:incoming>Flow_Access_31</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="T18" name="Tiếp nhận kết quả cấp quyền">
