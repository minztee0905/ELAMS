      <bpmn:outgoing>Flow_Access_21</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T11_Manager" name="Chuyển yêu cầu đã duyệt đến IT">
      <bpmn:incoming>Flow_Access_17</bpmn:incoming>
      <bpmn:outgoing>Flow_Access_22</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T11_Security" name="Chuyển yêu cầu đã duyệt đến IT">
      <bpmn:incoming>Flow_Access_19</bpmn:incoming>
      <bpmn:outgoing>Flow_Access_23</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T16" name="Xác minh hoặc bổ sung hồ sơ phê duyệt">
