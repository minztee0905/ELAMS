    <bpmn:startEvent id="S01" name="Phát sinh nhu cầu cấp quyền">
      <bpmn:outgoing>Flow_Access_01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="T01" name="Xác định nhu cầu truy cập">
      <bpmn:incoming>Flow_Access_01</bpmn:incoming>
      <bpmn:outgoing>Flow_Access_02</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T02" name="Gửi email yêu cầu cấp quyền">
      <bpmn:incoming>Flow_Access_02</bpmn:incoming>
      <bpmn:outgoing>Flow_Access_03</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T03" name="Kiểm tra yêu cầu và nhu cầu công việc">
      <bpmn:incoming>Flow_Access_03</bpmn:incoming>
      <bpmn:incoming>Flow_Access_10</bpmn:incoming>
      <bpmn:outgoing>Flow_Access_04</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G01" name="Thông tin yêu cầu đầy đủ?">
      <bpmn:incoming>Flow_Access_04</bpmn:incoming>
      <bpmn:outgoing>Flow_Access_05</bpmn:outgoing>
      <bpmn:outgoing>Flow_Access_06</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T04" name="Yêu cầu bổ sung thông tin">
      <bpmn:incoming>Flow_Access_06</bpmn:incoming>
      <bpmn:outgoing>Flow_Access_07</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G06" name="Người yêu cầu tiếp tục bổ sung?">
      <bpmn:documentation>Không = có xác nhận người yêu cầu không tiếp tục và đề nghị hủy. Không đồng nghĩa với không phản hồi; không tự động hủy theo thời gian.</bpmn:documentation>
      <bpmn:incoming>Flow_Access_07</bpmn:incoming>
      <bpmn:outgoing>Flow_Access_08</bpmn:outgoing>
      <bpmn:outgoing>Flow_Access_09</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T05" name="Bổ sung và gửi lại thông tin">
      <bpmn:incoming>Flow_Access_08</bpmn:incoming>
      <bpmn:outgoing>Flow_Access_10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T06" name="Xác nhận hoặc từ chối yêu cầu">
      <bpmn:documentation>Nếu Manager là người khởi tạo, phải làm rõ chính sách tự phê duyệt trước khi mở rộng luồng. Bản này thể hiện Employee khởi tạo theo danh sách BA cung cấp.</bpmn:documentation>
      <bpmn:incoming>Flow_Access_05</bpmn:incoming>
      <bpmn:outgoing>Flow_Access_11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G02" name="Manager phê duyệt?">
      <bpmn:incoming>Flow_Access_11</bpmn:incoming>
      <bpmn:outgoing>Flow_Access_12</bpmn:outgoing>
      <bpmn:outgoing>Flow_Access_13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T07" name="Thông báo lý do từ chối">
      <bpmn:incoming>Flow_Access_13</bpmn:incoming>
      <bpmn:outgoing>Flow_Access_14</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="E02" name="Manager từ chối yêu cầu">
      <bpmn:incoming>Flow_Access_14</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="T08" name="Xác định mức độ nhạy cảm của quyền">
      <bpmn:incoming>Flow_Access_12</bpmn:incoming>
      <bpmn:outgoing>Flow_Access_15</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G03" name="Quyền truy cập nhạy cảm?">
