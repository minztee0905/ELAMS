    <bpmn:subProcess id="SubProcess_DateChange" name="Ngoại lệ: thay đổi ngày bắt đầu làm việc" triggeredByEvent="true">
      <bpmn:documentation>Phát sinh trong khi onboarding còn đang xử lý. HR nhận thay đổi, cập nhật Excel và thông báo; IT và Manager điều chỉnh kế hoạch thủ công. Không tự động tính SLA. Cần kiểm tra theo ngày cập nhật trước khi HR xác nhận hoàn tất.</bpmn:documentation>
      <bpmn:laneSet id="LaneSet_DateChange">
        <bpmn:lane id="Lane_Date_HR" name="HR">
          <bpmn:flowNodeRef>Date_Start</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Date_Update</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Date_Notify</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="Lane_Date_IT" name="IT Staff">
          <bpmn:flowNodeRef>Date_IT</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="Lane_Date_Manager" name="Department Manager">
          <bpmn:flowNodeRef>Date_Manager</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Date_End</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="Date_Start" name="Nhận thông báo đổi ngày" isInterrupting="false">
        <bpmn:outgoing>Flow_040</bpmn:outgoing>
        <bpmn:messageEventDefinition id="MessageDef_Date_Start" messageRef="Message_DateChange" />
      </bpmn:startEvent>
      <bpmn:task id="Date_Update" name="Cập nhật ngày bắt đầu trong Excel">
        <bpmn:incoming>Flow_040</bpmn:incoming>
        <bpmn:outgoing>Flow_041</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="Date_Notify" name="Gửi email ngày mới cho IT và Manager">
        <bpmn:incoming>Flow_041</bpmn:incoming>
        <bpmn:outgoing>Flow_042</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="Date_IT" name="Điều chỉnh kế hoạch tài khoản và thiết bị">
        <bpmn:incoming>Flow_042</bpmn:incoming>
        <bpmn:outgoing>Flow_043</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="Date_Manager" name="Điều chỉnh kế hoạch tiếp nhận">
        <bpmn:incoming>Flow_043</bpmn:incoming>
        <bpmn:outgoing>Flow_044</bpmn:outgoing>
      </bpmn:task>
      <bpmn:endEvent id="Date_End" name="Đã cập nhật kế hoạch">
        <bpmn:incoming>Flow_044</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_040" sourceRef="Date_Start" targetRef="Date_Update" />
      <bpmn:sequenceFlow id="Flow_041" sourceRef="Date_Update" targetRef="Date_Notify" />
      <bpmn:sequenceFlow id="Flow_042" sourceRef="Date_Notify" targetRef="Date_IT" />
      <bpmn:sequenceFlow id="Flow_043" sourceRef="Date_IT" targetRef="Date_Manager" />
      <bpmn:sequenceFlow id="Flow_044" sourceRef="Date_Manager" targetRef="Date_End" />
    </bpmn:subProcess>
