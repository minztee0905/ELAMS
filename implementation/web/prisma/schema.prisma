// ELAMS – mô hình vật lý từ data-models/data-dictionary.md (23 bảng)
// cộng bảng hạ tầng system_setting (đồng hồ giả lập, cấu hình hạn).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Enum ----------

enum ActiveStatus {
  ACTIVE
  INACTIVE
}

enum EmployeeStatus {
  PRE_HIRE
  ACTIVE
  OFFBOARDING
  LEFT
}

enum Role {
  EMPLOYEE
  MANAGER
  HR
  IT
  SECURITY
  ADMIN
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum DeviceType {
  LAPTOP
  MONITOR
  PHONE
  OTHER
}

enum DeviceStatus {
  IN_STOCK
  ASSIGNED
  EXCEPTION_NOT_RETURNED
  RETIRED
}

enum AccountStatus {
  ACTIVE
  DISABLED
  REVOKED
}

enum GrantSource {
  ONBOARDING
  ACCESS_REQUEST
  MANUAL
}

enum GrantStatus {
  ACTIVE
  SUSPENDED
  REVOKED
}

enum CaseStatus {
  IN_PROGRESS
  PENDING_CONDITIONS
  PENDING_HR_CONFIRMATION
  COMPLETED
}

enum OnAccessStatus {
  WAITING
  IN_PROGRESS
  COMPLETED
  REJECTED
  BLOCKED
}

enum OnAccessStep {
  MANAGER_REVIEW
  SECURITY_REVIEW
  IT_PROVISION
}

enum OnDeviceStatus {
  PREPARING
  WAITING_DEVICE
  HANDED_OVER
}

enum HandoverCondition {
  NEW
  USED_GOOD
  USED_NOTED
}

enum AccessRequestStatus {
  PENDING_MANAGER
  NEED_INFO
  PENDING_SECURITY
  PENDING_PROVISION
  GRANTED
  REJECTED
  CANCELLED
}

enum ApproverRole {
  MANAGER
  SECURITY
}

enum Decision {
  APPROVE
  REJECT
  REQUEST_INFO
}

enum LeaveReason {
  VOLUNTARY
  TERMINATION
  OTHER
}

enum HandoverStatus {
  NOT_HANDED_OVER
  HANDED_OVER
  NOT_MET
}

enum RevocationSource {
  ELAMS
  MANUAL
}

enum RevocationStatus {
  WAITING
  IN_PROGRESS
  REVOKED
  DISABLED
  NOT_REVOKED
}

enum DeviceReturnStatus {
  WAITING
  RETURNED
  MISSING_PENDING_DECISION
  EXCEPTION_NOT_RETURNED
}

enum ReturnCondition {
  GOOD
  MINOR_DAMAGE
  MAJOR_DAMAGE
}

enum TaskType {
  ON_ACCESS_REVIEW
  ON_ACCESS_ADJUST
  SECURITY_REVIEW
  PROVISION
  ON_DEVICE
  ON_CONFIRM
  AR_REVIEW
  AR_NEED_INFO
  OFF_HANDOVER
  OFF_HANDOVER_UPDATE
  OFF_REVOKE
  OFF_DEVICE
  OFF_DEVICE_EXCEPTION
  OFF_CONFIRM
}

enum ObjectType {
  ONBOARDING_REQUEST
  ONBOARDING_ACCESS_ITEM
  ONBOARDING_DEVICE_ITEM
  ACCESS_REQUEST
  OFFBOARDING_REQUEST
  HANDOVER_ITEM
  REVOCATION_ITEM
  DEVICE_RETURN_ITEM
  EMPLOYEE
  CATALOG
  APP_USER
  SYSTEM
}

enum TaskStatus {
  OPEN
  WAITING
  DONE
  CANCELLED
}

enum SendStatus {
  SENT
  FAILED
}

// ---------- 2. Tổ chức và người dùng ----------

model Department {
  id        Int          @id @default(autoincrement()) @map("department_id")
  name      String       @unique @db.VarChar(100)
  status    ActiveStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  employees Employee[]

  @@map("department")
}

model JobTitle {
  id        Int          @id @default(autoincrement()) @map("job_title_id")
  name      String       @unique @db.VarChar(100)
  status    ActiveStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  employees       Employee[]
  accessTemplates PositionAccessTemplate[]
  deviceTemplates PositionDeviceTemplate[]

  @@map("job_title")
}

model Employee {
  id              Int            @id @default(autoincrement()) @map("employee_id")
  employeeCode    String         @unique @map("employee_code") @db.VarChar(20)
  fullName        String         @map("full_name") @db.VarChar(100)
  personalEmail   String         @map("personal_email") @db.VarChar(150)
  departmentId    Int            @map("department_id")
  jobTitleId      Int            @map("job_title_id")
  managerId       Int?           @map("manager_id")
  status          EmployeeStatus
  startDate       DateTime       @map("start_date") @db.Date
  lastWorkingDate DateTime?      @map("last_working_date") @db.Date
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  department Department @relation(fields: [departmentId], references: [id])
  jobTitle   JobTitle   @relation(fields: [jobTitleId], references: [id])
  manager    Employee?  @relation("ManagerOf", fields: [managerId], references: [id])
  reports    Employee[] @relation("ManagerOf")

  user                 AppUser?
  accounts             SystemAccount[]
  grants               AccessGrant[]
  devicesHeld          Device[]
  onboardings          OnboardingRequest[]  @relation("OnboardingEmployee")
  onboardingsManaged   OnboardingRequest[]  @relation("OnboardingManager")
  accessRequests       AccessRequest[]      @relation("Requester")
  accessRequestsToVet  AccessRequest[]      @relation("Approver")
  offboardings         OffboardingRequest[]
  handoverItemsReceive HandoverItem[]

  @@map("employee")
}

model AppUser {
  id         Int        @id @default(autoincrement()) @map("user_id")
  employeeId Int        @unique @map("employee_id")
  username   String     @unique @db.VarChar(50)
  role       Role
  status     UserStatus @default(ACTIVE)
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")

  employee Employee @relation(fields: [employeeId], references: [id])

  hrOnboardings      OnboardingRequest[]    @relation("OnboardingHr")
  hrOffboardings     OffboardingRequest[]   @relation("OffboardingHr")
  decisions          ApprovalDecision[]
  devicesHandedOut   OnboardingDeviceItem[]
  tasks              Task[]
  notifications      Notification[]
  auditLogs          AuditLog[]
  handoverUpdates    HandoverItem[]
  deviceExceptions   DeviceReturnItem[]

  @@map("app_user")
}

// ---------- 3. Danh mục ----------

model TargetSystem {
  id        Int          @id @default(autoincrement()) @map("system_id")
  name      String       @unique @db.VarChar(100)
  status    ActiveStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  accesses    AccessCatalog[]
  accounts    SystemAccount[]
  revocations RevocationItem[]

  @@map("target_system")
}

model AccessCatalog {
  id           Int          @id @default(autoincrement()) @map("access_id")
  systemId     Int          @map("system_id")
  name         String       @db.VarChar(100)
  accessLevels String       @map("access_levels") @db.VarChar(200)
  isSensitive  Boolean      @map("is_sensitive")
  status       ActiveStatus @default(ACTIVE)
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  system          TargetSystem             @relation(fields: [systemId], references: [id])
  templates       PositionAccessTemplate[]
  onboardingItems OnboardingAccessItem[]
  requests        AccessRequest[]
  grants          AccessGrant[]

  @@unique([systemId, name])
  @@map("access_catalog")
}

model PositionAccessTemplate {
  id           Int     @id @default(autoincrement()) @map("template_id")
  jobTitleId   Int     @map("job_title_id")
  accessId     Int     @map("access_id")
  defaultLevel String  @map("default_level") @db.VarChar(50)
  isMandatory  Boolean @map("is_mandatory")
  sequenceNo   Int     @map("sequence_no")

  jobTitle JobTitle      @relation(fields: [jobTitleId], references: [id])
  access   AccessCatalog @relation(fields: [accessId], references: [id])

  @@unique([jobTitleId, accessId])
  @@map("position_access_template")
}

model PositionDeviceTemplate {
  id         Int        @id @default(autoincrement()) @map("template_id")
  jobTitleId Int        @map("job_title_id")
  deviceType DeviceType @map("device_type")
  configNote String?    @map("config_note") @db.VarChar(200)

  jobTitle JobTitle @relation(fields: [jobTitleId], references: [id])

  @@map("position_device_template")
}

model Device {
  id               Int          @id @default(autoincrement()) @map("device_id")
  assetCode        String       @unique @map("asset_code") @db.VarChar(30)
  deviceType       DeviceType   @map("device_type")
  description      String?      @db.VarChar(200)
  status           DeviceStatus
  holderEmployeeId Int?         @map("holder_employee_id")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  holder          Employee?              @relation(fields: [holderEmployeeId], references: [id])
  onboardingItems OnboardingDeviceItem[]
  returnItems     DeviceReturnItem[]

  @@map("device")
}

// ---------- 4. Cấp phát ----------

model SystemAccount {
  id                Int           @id @default(autoincrement()) @map("account_id")
  employeeId        Int           @map("employee_id")
  systemId          Int           @map("system_id")
  accountIdentifier String        @map("account_identifier") @db.VarChar(100)
  status            AccountStatus
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  employee        Employee               @relation(fields: [employeeId], references: [id])
  system          TargetSystem           @relation(fields: [systemId], references: [id])
  grants          AccessGrant[]
  onboardingItems OnboardingAccessItem[]
  requests        AccessRequest[]
  revocations     RevocationItem[]

  @@unique([employeeId, systemId]) // BR-ON-10
  @@map("system_account")
}

model AccessGrant {
  id          Int         @id @default(autoincrement()) @map("grant_id")
  employeeId  Int         @map("employee_id")
  accessId    Int?        @map("access_id")
  accountId   Int         @map("account_id")
  accessLevel String      @map("access_level") @db.VarChar(50)
  source      GrantSource
  grantedAt   DateTime    @map("granted_at")
  status      GrantStatus
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  employee   Employee        @relation(fields: [employeeId], references: [id])
  access     AccessCatalog?  @relation(fields: [accessId], references: [id])
  account    SystemAccount   @relation(fields: [accountId], references: [id])
  revocation RevocationItem?

  @@map("access_grant")
}

// ---------- 5. Onboarding ----------

model OnboardingRequest {
  id                Int        @id @default(autoincrement()) @map("onboarding_id")
  requestCode       String     @unique @map("request_code") @db.VarChar(20)
  employeeId        Int        @map("employee_id")
  managerId         Int        @map("manager_id")
  hrUserId          Int        @map("hr_user_id")
  startDate         DateTime   @map("start_date") @db.Date
  originalStartDate DateTime?  @map("original_start_date") @db.Date
  status            CaseStatus
  note              String?
  submissionKey     String?    @unique @map("submission_key") @db.VarChar(64) // NFR-04: gửi lại không tạo trùng
  completedAt       DateTime?  @map("completed_at")
  conditionsCheckedRev Int     @default(0) @map("conditions_checked_rev") // BR-ON-07
  dataRev           Int        @default(0) @map("data_rev")
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")

  employee    Employee               @relation("OnboardingEmployee", fields: [employeeId], references: [id])
  manager     Employee               @relation("OnboardingManager", fields: [managerId], references: [id])
  hrUser      AppUser                @relation("OnboardingHr", fields: [hrUserId], references: [id])
  accessItems OnboardingAccessItem[]
  deviceItems OnboardingDeviceItem[]

  @@map("onboarding_request")
}

model OnboardingAccessItem {
  id            Int            @id @default(autoincrement()) @map("item_id")
  onboardingId  Int            @map("onboarding_id")
  accessId      Int            @map("access_id")
  accessLevel   String         @map("access_level") @db.VarChar(50)
  isMandatory   Boolean        @map("is_mandatory")
  fromTemplate  Boolean        @default(false) @map("from_template")
  sequenceNo    Int            @map("sequence_no")
  status        OnAccessStatus
  currentStep   OnAccessStep?  @map("current_step")
  blockedReason String?        @map("blocked_reason") @db.VarChar(500)
  blockedKind   String?        @map("blocked_kind") @db.VarChar(30) // REVIEW_REJECTED, PROVISION_FAILED, APPROVAL_INVALID, REVOKED_AWAITING_APPROVAL
  accountId     Int?           @map("account_id")
  evidenceRef   String?        @map("evidence_ref") @db.VarChar(300)
  approvalRound Int            @default(1) @map("approval_round")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  onboarding OnboardingRequest  @relation(fields: [onboardingId], references: [id])
  access     AccessCatalog      @relation(fields: [accessId], references: [id])
  account    SystemAccount?     @relation(fields: [accountId], references: [id])
  decisions  ApprovalDecision[]

  @@unique([onboardingId, accessId])
  @@map("onboarding_access_item")
}

model OnboardingDeviceItem {
  id                 Int                @id @default(autoincrement()) @map("item_id")
  onboardingId       Int                @map("onboarding_id")
  deviceType         DeviceType         @map("device_type")
  configNote         String?            @map("config_note") @db.VarChar(200)
  fromTemplate       Boolean            @default(false) @map("from_template")
  deviceId           Int?               @map("device_id")
  status             OnDeviceStatus
  waitingReason      String?            @map("waiting_reason") @db.VarChar(300)
  expectedAt         DateTime?          @map("expected_at") @db.Date
  waitingSince       DateTime?          @map("waiting_since")
  handedOverAt       DateTime?          @map("handed_over_at")
  deviceCondition    HandoverCondition? @map("device_condition")
  conditionNote      String?            @map("condition_note") @db.VarChar(300)
  handoverRecordCode String?            @map("handover_record_code") @db.VarChar(30)
  handoverRecordFile String?            @map("handover_record_file") @db.VarChar(300)
  handedById         Int?               @map("handed_by")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  onboarding OnboardingRequest @relation(fields: [onboardingId], references: [id])
  device     Device?           @relation(fields: [deviceId], references: [id])
  handedBy   AppUser?          @relation(fields: [handedById], references: [id])

  @@map("onboarding_device_item")
}

// ---------- 6. Access Request ----------

model AccessRequest {
  id          Int                 @id @default(autoincrement()) @map("request_id")
  requestCode String              @unique @map("request_code") @db.VarChar(20)
  requesterId Int                 @map("requester_id")
  accessId    Int                 @map("access_id")
  accessLevel String              @map("access_level") @db.VarChar(50)
  reason      String
  neededBy    DateTime?           @map("needed_by") @db.Date
  attachment  String?             @db.VarChar(300)
  approverId  Int                 @map("approver_id")
  status      AccessRequestStatus
  accountId   Int?                @map("account_id")
  evidenceRef String?             @map("evidence_ref") @db.VarChar(300)
  provisionFailure String?        @map("provision_failure") @db.VarChar(500)
  submissionKey String?           @unique @map("submission_key") @db.VarChar(64)
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")

  requester Employee           @relation("Requester", fields: [requesterId], references: [id])
  approver  Employee           @relation("Approver", fields: [approverId], references: [id])
  access    AccessCatalog      @relation(fields: [accessId], references: [id])
  account   SystemAccount?     @relation(fields: [accountId], references: [id])
  decisions ApprovalDecision[]

  @@map("access_request")
}

model ApprovalDecision {
  id               Int          @id @default(autoincrement()) @map("decision_id")
  onboardingItemId Int?         @map("onboarding_item_id")
  accessRequestId  Int?         @map("access_request_id")
  decidedById      Int          @map("decided_by")
  approverRole     ApproverRole @map("approver_role")
  decision         Decision
  accessLevel      String?      @map("access_level") @db.VarChar(50)
  round            Int          @default(1)
  reason           String?
  decidedAt        DateTime     @map("decided_at")

  onboardingItem OnboardingAccessItem? @relation(fields: [onboardingItemId], references: [id])
  accessRequest  AccessRequest?        @relation(fields: [accessRequestId], references: [id])
  decidedBy      AppUser               @relation(fields: [decidedById], references: [id])

  @@map("approval_decision")
}

// ---------- 7. Offboarding ----------

model OffboardingRequest {
  id                  Int         @id @default(autoincrement()) @map("offboarding_id")
  requestCode         String      @unique @map("request_code") @db.VarChar(20)
  employeeId          Int         @map("employee_id")
  hrUserId            Int         @map("hr_user_id")
  lastWorkingDate     DateTime    @map("last_working_date") @db.Date
  originalLastWorkingDate DateTime? @map("original_last_working_date") @db.Date
  leaveReason         LeaveReason @map("leave_reason")
  isUrgent            Boolean     @map("is_urgent")
  urgentReason        String?     @map("urgent_reason") @db.VarChar(500)
  revokeAt            DateTime    @map("revoke_at")
  revokeDueAt         DateTime?   @map("revoke_due_at")
  handoverConfirmedAt DateTime?   @map("handover_confirmed_at")
  status              CaseStatus
  note                String?
  submissionKey       String?     @unique @map("submission_key") @db.VarChar(64)
  completedAt         DateTime?   @map("completed_at")
  conditionsCheckedRev Int        @default(0) @map("conditions_checked_rev")
  dataRev             Int         @default(0) @map("data_rev")
  createdAt           DateTime    @default(now()) @map("created_at")
  updatedAt           DateTime    @updatedAt @map("updated_at")

  employee      Employee           @relation(fields: [employeeId], references: [id])
  hrUser        AppUser            @relation("OffboardingHr", fields: [hrUserId], references: [id])
  handoverItems HandoverItem[]
  revocations   RevocationItem[]
  deviceReturns DeviceReturnItem[]

  @@map("offboarding_request")
}

model HandoverItem {
  id           Int            @id @default(autoincrement()) @map("item_id")
  offboardingId Int           @map("offboarding_id")
  title        String         @db.VarChar(200)
  receiverId   Int            @map("receiver_id")
  dueDate      DateTime       @map("due_date") @db.Date
  status       HandoverStatus
  notMetReason String?        @map("not_met_reason") @db.VarChar(500)
  updatedById  Int?           @map("updated_by")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  offboarding OffboardingRequest @relation(fields: [offboardingId], references: [id])
  receiver    Employee           @relation(fields: [receiverId], references: [id])
  updatedBy   AppUser?           @relation(fields: [updatedById], references: [id])

  @@map("handover_item")
}

model RevocationItem {
  id            Int              @id @default(autoincrement()) @map("item_id")
  offboardingId Int              @map("offboarding_id")
  grantId       Int?             @unique @map("grant_id")
  systemId      Int              @map("system_id")
  accountId     Int?             @map("account_id")
  accessName    String           @map("access_name") @db.VarChar(100)
  accessLevel   String?          @map("access_level") @db.VarChar(50)
  source        RevocationSource
  status        RevocationStatus
  evidenceRef   String?          @map("evidence_ref") @db.VarChar(300)
  failureReason String?          @map("failure_reason") @db.VarChar(500)
  processedAt   DateTime?        @map("processed_at")
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")

  offboarding OffboardingRequest @relation(fields: [offboardingId], references: [id])
  grant       AccessGrant?       @relation(fields: [grantId], references: [id])
  system      TargetSystem       @relation(fields: [systemId], references: [id])
  account     SystemAccount?     @relation(fields: [accountId], references: [id])

  @@map("revocation_item")
}

model DeviceReturnItem {
  id              Int                @id @default(autoincrement()) @map("item_id")
  offboardingId   Int                @map("offboarding_id")
  deviceId        Int                @map("device_id")
  status          DeviceReturnStatus
  returnedAt      DateTime?          @map("returned_at")
  deviceCondition ReturnCondition?   @map("device_condition")
  missingReason   String?            @map("missing_reason") @db.VarChar(500)
  evidenceRef     String?            @map("evidence_ref") @db.VarChar(300)
  exceptionById   Int?               @map("exception_by")
  exceptionReason String?            @map("exception_reason") @db.VarChar(500)
  exceptionAt     DateTime?          @map("exception_at")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  offboarding OffboardingRequest @relation(fields: [offboardingId], references: [id])
  device      Device             @relation(fields: [deviceId], references: [id])
  exceptionBy AppUser?           @relation(fields: [exceptionById], references: [id])

  @@map("device_return_item")
}

// ---------- 8. Dùng chung ----------

model Task {
  id                Int        @id @default(autoincrement()) @map("task_id")
  taskType          TaskType   @map("task_type")
  objectType        ObjectType @map("object_type")
  objectId          Int        @map("object_id")
  caseCode          String?    @map("case_code") @db.VarChar(20) // mã yêu cầu cha, để lọc và hiển thị
  title             String     @db.VarChar(200)
  assigneeId        Int        @map("assignee_id")
  dueAt             DateTime?  @map("due_at")
  status            TaskStatus
  isUrgent          Boolean    @default(false) @map("is_urgent")
  overdueAlertedFor DateTime?  @map("overdue_alerted_for")
  reminderSentFor   DateTime?  @map("reminder_sent_for") // FR-GEN-07
  completedAt       DateTime?  @map("completed_at")
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")

  assignee      AppUser        @relation(fields: [assigneeId], references: [id])
  notifications Notification[]

  @@index([assigneeId, status])
  @@index([objectType, objectId])
  @@map("task")
}

model Notification {
  id          Int        @id @default(autoincrement()) @map("notification_id")
  recipientId Int        @map("recipient_id")
  taskId      Int?       @map("task_id")
  message     String     @db.VarChar(500)
  link        String?    @db.VarChar(200)
  isRead      Boolean    @default(false) @map("is_read")
  sendStatus  SendStatus @map("send_status")
  createdAt   DateTime   @map("created_at")

  recipient AppUser @relation(fields: [recipientId], references: [id])
  task      Task?   @relation(fields: [taskId], references: [id])

  @@index([recipientId, isRead])
  @@map("notification")
}

model AuditLog {
  id         Int        @id @default(autoincrement()) @map("log_id")
  actorId    Int?       @map("actor_id")
  action     String     @db.VarChar(50)
  objectType ObjectType @map("object_type")
  objectId   Int        @map("object_id")
  caseCode   String?    @map("case_code") @db.VarChar(20)
  result     String     @db.VarChar(50)
  reason     String?
  createdAt  DateTime   @map("created_at")

  actor AppUser? @relation(fields: [actorId], references: [id])

  @@index([caseCode])
  @@map("audit_log")
}

// ---------- Hạ tầng (không thuộc ERD nghiệp vụ) ----------

model SystemSetting {
  key   String @id @db.VarChar(50)
  value String @db.VarChar(200)

  @@map("system_setting")
}
